    mul sha_tmp, c148, alive                                ; str_i * alive_(i-1) = str_i * alive_i
    div alive, sha_tmp, pow16       | resmode:ceil          ; alive_i: 1 if that's non-zero
    add c1324, sha_tmp              | itemmod:256
    sub c1324, alive                | itemmod:32640         ; -128 * 256 * alive_i + 128 * alive_i
    add c1331, alive                | itemmod:8
    mul sha_tmp, c149, alive                                ; str_i * alive_(i-1) = str_i * alive_i
    div alive, sha_tmp, pow16       | resmode:ceil          ; alive_i: 1 if that's non-zero
    add c1324, sha_tmp
    sub c1324, alive                | itemmod:128
    add c1331, alive                | itemmod:8
    mov c1325, alive                | itemmod:32768         ; byte 50: 0x80 if all 50 bytes are non-zero
    mov c1326, 0
    mov c1327, 0
    mov c1328, 0
    mov c1329, 0
    mov c1330, 0
    ; a..h = the initial hash values, and the round constants
    mov a_hi, 27145                                         ; a = 0x6a09e667
    mov a_lo, 58983
    mov b_hi, 47975                                         ; b = 0xbb67ae85
    mov b_lo, 44677
    mov c_hi, 15470                                         ; c = 0x3c6ef372
    mov c_lo, 62322
    mov d_hi, 42319                                         ; d = 0xa54ff53a
    mov d_lo, 62778
    mov e_hi, 20750                                         ; e = 0x510e527f
    mov e_lo, 21119
    mov f_hi, 39685                                         ; f = 0x9b05688c
    mov f_lo, 26764
    mov g_hi, 8067                                          ; g = 0x1f83d9ab
    mov g_lo, 55723
    mov h_hi, 23520                                         ; h = 0x5be0cd19
    mov h_lo, 52505
    ; GD saves numbers in instructions with 6 significant digits, so each K is loaded in two parts:
    ; a round number that survives that (and is exact as a 32-bit float), then the rest (below 1,000,000)
    mov c1400, 1116320000                                   ; K[0] = 0x428a2f98
    add c1400, 32408
    mov c1401, 1899440000                                   ; K[1] = 0x71374491
    add c1401, 7441
