; sha256 of the string starting at offset 100
_init:
    import ../../stdlib/bits

    alias strlen, 50        ; maximum length: the string ends at its first 0 byte or after 50 bytes
    alias str_offset, 100

    alias a_hi,           c1200    ; working variable a
    alias a_lo,           c1201
    alias b_hi,           c1202    ; working variable b
    alias b_lo,           c1203
    alias c_hi,           c1204    ; working variable c
    alias c_lo,           c1205
    alias d_hi,           c1206    ; working variable d
    alias d_lo,           c1207
    alias e_hi,           c1208    ; working variable e
    alias e_lo,           c1209
    alias f_hi,           c1210    ; working variable f
    alias f_lo,           c1211
    alias g_hi,           c1212    ; working variable g
    alias g_lo,           c1213
    alias h_hi,           c1214    ; working variable h
    alias h_lo,           c1215
    alias t1_hi,          c1600    ; T1, not reduced mod 2^32
    alias t1_lo,          c1601
    alias t2_hi,          c1602    ; S0(a) + Maj(a, b, c), not reduced
    alias t2_lo,          c1603
    alias sha_round,      c3000    ; rounds done
    alias sha_tmp,        c3001    ; scratch
    alias carry,          c3002    ; carry between the halves
    alias alive,          c3003    ; 1 while the string hasn't ended
    alias arg_x,          c3010    ; operands: one 16-bit half each
    alias arg_y,          c3011
    alias arg_z,          c3012
    alias res_xor,        c3013    ; x ^ y ^ z, and x & y or Maj(x, y, z)
    alias res_maj,        c3014
    alias sum_a,          c3015    ; scratch
    alias sum_b,          c3016
    alias rot_q0,         c3020    ; rotations: each half shifted right
    alias rot_q1,         c3021
    alias rot_q2,         c3022
    alias rot_q3,         c3023
    alias rot_q4,         c3024
    alias rot_q5,         c3025
    alias pow1,           c3031    ; 2^n, for fldiv
    alias pow2,           c3032
    alias pow3,           c3033
    alias pow6,           c3036
    alias pow7,           c3037
    alias pow8,           c3038
    alias pow9,           c3039
    alias pow10,          c3040
    alias pow11,          c3041
    alias pow13,          c3043
    alias pow16,          c3046

    ; the hash, one byte per counter (bottom display = first byte)
    display c20         ; expected: 49
    display c21         ; expected: 95
    display c22         ; expected: 91
    display c23         ; expected: 219
    display c24         ; expected: 118
    display c25         ; expected: 208
    display c26         ; expected: 120
    display c27         ; expected: 196
    display c28         ; expected: 59
    display c29         ; expected: 138
    display c30         ; expected: 192
    display c31         ; expected: 6
    display c32         ; expected: 78
    display c33         ; expected: 74
    display c34         ; expected: 1
    display c35         ; expected: 100
    display c36         ; expected: 97
    display c37         ; expected: 43
    display c38         ; expected: 31
    display c39         ; expected: 206
    display c40         ; expected: 119
    display c41         ; expected: 200
    display c42         ; expected: 105
    display c43         ; expected: 52
    display c44         ; expected: 91
    display c45         ; expected: 252
    display c46         ; expected: 148
    display c47         ; expected: 199
    display c48         ; expected: 88
    display c49         ; expected: 148
    display c50         ; expected: 237
    display c51         ; expected: 211

_start:
    ; load string: "Hello, world!"
    ; expected sha256 hash: 315f5bdb76d078c43b8ac0064e4a0164612b1fce77c869345bfc94c75894edd3
    mov C100, 72        ; H
    mov C101, 101       ; e
    mov C102, 108       ; l
    mov C103, 108       ; l
    mov C104, 111       ; o
    mov C105, 44        ; ,
    mov C106, 32        ; (space)
    mov C107, 119       ; w
    mov C108, 111       ; o
    mov C109, 114       ; r
    mov C110, 108       ; l
    mov C111, 100       ; d
    mov C112, 33        ; !
    spawn sha256                | ordered:false delay:0

; SHA-256 of the string at c100.. (one byte per counter, 0-255). The string ends at its first 0
; byte or after 50 bytes, so it always fits in one 512-bit block. The 32 bytes of the hash
; end up in c20 - c51, most significant byte first.
;
; Every 32-bit word is two counters holding its high and low 16 bits. Item layout:
;     c1200-c1215: the working variables a..h (a_hi, a_lo, b_hi, ...)
;     c1300-c1333: the message schedule W[t] .. W[t + 16], as hi/lo pairs
;     c1400-c1463: the round constants that are still to come, as signed int32 (K - 2^32 if K >= 2^31)
;     c1600-c1603: sums used during a round
;     c3000-c3025: scratch, c3030-c3046: powers of two
; @0tick, but the rounds run afterwards, one per tick (64 ticks)
sha256:
    mov sha_round, 0
    mov pow1, 2
    mov pow2, 4
    mov pow3, 8
    mov pow6, 64
    mov pow7, 128
    mov pow8, 256
    mov pow9, 512
    mov pow10, 1024
    mov pow11, 2048
    mov pow13, 8192
    mov pow16, 65536
    ; the padded block, straight into W[0..15]: each 16-bit half is two bytes. Byte i is
    ;     alive_i * str_i + 128 * (alive_(i-1) - alive_i),   alive_i = 1 while bytes 0..i are all non-zero
    ; which puts 0x80 after the string. The last half (bytes 62-63) is the length in bits.
    mov c1331, 0
    mov alive, 1
    mov c1300, alive                | itemmod:32768         ; bytes 0, 1: 128 * 256 * alive_-1
    mul sha_tmp, c100, alive                                ; str_i * alive_(i-1) = str_i * alive_i
    div alive, sha_tmp, pow16       | resmode:ceil          ; alive_i: 1 if that's non-zero
    add c1300, sha_tmp              | itemmod:256
    sub c1300, alive                | itemmod:32640         ; -128 * 256 * alive_i + 128 * alive_i
    add c1331, alive                | itemmod:8
    mul sha_tmp, c101, alive                                ; str_i * alive_(i-1) = str_i * alive_i
    div alive, sha_tmp, pow16       | resmode:ceil          ; alive_i: 1 if that's non-zero
    add c1300, sha_tmp
    sub c1300, alive                | itemmod:128
    add c1331, alive                | itemmod:8
    mov c1301, alive                | itemmod:32768         ; bytes 2, 3: 128 * 256 * alive_1
    mul sha_tmp, c102, alive                                ; str_i * alive_(i-1) = str_i * alive_i
    div alive, sha_tmp, pow16       | resmode:ceil          ; alive_i: 1 if that's non-zero
    add c1301, sha_tmp              | itemmod:256
    sub c1301, alive                | itemmod:32640         ; -128 * 256 * alive_i + 128 * alive_i
    add c1331, alive                | itemmod:8
    mul sha_tmp, c103, alive                                ; str_i * alive_(i-1) = str_i * alive_i
    div alive, sha_tmp, pow16       | resmode:ceil          ; alive_i: 1 if that's non-zero
    add c1301, sha_tmp
    sub c1301, alive                | itemmod:128
    add c1331, alive                | itemmod:8
    mov c1302, alive                | itemmod:32768         ; bytes 4, 5: 128 * 256 * alive_3
    mul sha_tmp, c104, alive                                ; str_i * alive_(i-1) = str_i * alive_i
    div alive, sha_tmp, pow16       | resmode:ceil          ; alive_i: 1 if that's non-zero
    add c1302, sha_tmp              | itemmod:256
    sub c1302, alive                | itemmod:32640         ; -128 * 256 * alive_i + 128 * alive_i
    add c1331, alive                | itemmod:8
    mul sha_tmp, c105, alive                                ; str_i * alive_(i-1) = str_i * alive_i
    div alive, sha_tmp, pow16       | resmode:ceil          ; alive_i: 1 if that's non-zero
    add c1302, sha_tmp
    sub c1302, alive                | itemmod:128
    add c1331, alive                | itemmod:8
    mov c1303, alive                | itemmod:32768         ; bytes 6, 7: 128 * 256 * alive_5
    mul sha_tmp, c106, alive                                ; str_i * alive_(i-1) = str_i * alive_i
    div alive, sha_tmp, pow16       | resmode:ceil          ; alive_i: 1 if that's non-zero
    add c1303, sha_tmp              | itemmod:256
    sub c1303, alive                | itemmod:32640         ; -128 * 256 * alive_i + 128 * alive_i
    add c1331, alive                | itemmod:8
