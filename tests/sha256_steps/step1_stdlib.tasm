    add c1442, 3504
    mov c1443, -949200000                                   ; K[43] = 0xc76c51a3
    add c1443, -2525
    mov c1444, -778904000                                   ; K[44] = 0xd192e819
    add c1444, 2521
    mov c1445, -694616000                                   ; K[45] = 0xd6990624
    add c1445, 1508
    mov c1446, -200396000                                   ; K[46] = 0xf40e3585
    add c1446, 613
    mov c1447, 275424000                                    ; K[47] = 0x106aa070
    add c1447, -656
    mov c1448, 430228000                                    ; K[48] = 0x19a4c116
    add c1448, -266
    mov c1449, 506948000                                    ; K[49] = 0x1e376c08
    add c1449, 616
    mov c1450, 659064000                                    ; K[50] = 0x2748774c
    add c1450, -3444
    mov c1451, 884000000                                    ; K[51] = 0x34b0bcb5
    add c1451, -2123
    mov c1452, 958136000                                    ; K[52] = 0x391c0cb3
    add c1452, 3571
    mov c1453, 1322800000                                   ; K[53] = 0x4ed8aa4a
    add c1453, 22218
    mov c1454, 1537040000                                   ; K[54] = 0x5b9cca4f
    add c1454, -37937
    mov c1455, 1747840000                                   ; K[55] = 0x682e6ff3
    add c1455, 33779
    mov c1456, 1955600000                                   ; K[56] = 0x748f82ee
    add c1456, -37778
    mov c1457, 2024080000                                   ; K[57] = 0x78a5636f
    add c1457, 24815
    mov c1458, -2067200000                                  ; K[58] = 0x84c87814
    add c1458, -36844
    mov c1459, -1933120000                                  ; K[59] = 0x8cc70208
    add c1459, 5128
    mov c1460, -1866560000                                  ; K[60] = 0x90befffa
    add c1460, 29178
    mov c1461, -1538240000                                  ; K[61] = 0xa4506ceb
    add c1461, 6891
    mov c1462, -1090960000                                  ; K[62] = 0xbef9a3f7
    add c1462, 24183
    mov c1463, -965640000                                   ; K[63] = 0xc67178f2
    add c1463, -1998
    spawn sha256_round              | ordered:false         ; the next tick

; One round of the compression function, and the next word of the message schedule.
; not 0-tickable: loops by spawning itself (64 times, one tick each)
sha256_round:
    ; T1 = h + K[t] + W[t] + S1(e) + Ch(e, f, g). K[t] goes into the low half whole (it can be negative):
    ; the carry steps after e = d + T1 and a = T1 + T2 move it into the high half
    add t1_hi, h_hi, c1300
    add t1_lo, h_lo, c1400
    add t1_lo, c1301
    ; S1(e) = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
    fldiv rot_q0, e_hi, pow6                                ; rotr 6
    fldiv rot_q1, e_lo, pow6
    fldiv rot_q2, e_hi, pow11                               ; rotr 11
    fldiv rot_q3, e_lo, pow11
    fldiv rot_q4, e_lo, pow9                                ; rotr 25
    fldiv rot_q5, e_hi, pow9
    mov arg_x, e_lo                 | itemmod:1024
    sub arg_x, rot_q1               | itemmod:65536
    add arg_x, rot_q0
    mov arg_y, e_lo                 | itemmod:32
    sub arg_y, rot_q3               | itemmod:65536
    add arg_y, rot_q2
    mov arg_z, e_hi                 | itemmod:128
    sub arg_z, rot_q5               | itemmod:65536
    add arg_z, rot_q4
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = sum_a, -1 = -1001 }
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = sum_a, c2 = arg_z, c3 = res_xor, -2 = -1002 }
    add t1_hi, res_xor
    mov arg_x, e_hi                 | itemmod:1024
    sub arg_x, rot_q0               | itemmod:65536
    add arg_x, rot_q1
    mov arg_y, e_hi                 | itemmod:32
    sub arg_y, rot_q2               | itemmod:65536
    add arg_y, rot_q3
    mov arg_z, e_lo                 | itemmod:128
    sub arg_z, rot_q4               | itemmod:65536
    add arg_z, rot_q5
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = sum_a, -3 = -1003 }
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = sum_a, c2 = arg_z, c3 = res_xor, -4 = -1004 }
    add t1_lo, res_xor
    ; Ch(e, f, g) = (e & f) + g - (e & g)
    mov arg_x, e_hi
    mov arg_y, f_hi
    spawn bits::bitwise_and         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = res_maj, -5 = -1005 }
    add t1_hi, res_maj
    add t1_hi, g_hi
    mov arg_x, e_hi
    mov arg_y, g_hi
    spawn bits::bitwise_and         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = res_maj, -6 = -1006 }
    sub t1_hi, res_maj
    mov arg_x, e_lo
    mov arg_y, f_lo
    spawn bits::bitwise_and         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = res_maj, -7 = -1007 }
    add t1_lo, res_maj
    add t1_lo, g_lo
    mov arg_x, e_lo
    mov arg_y, g_lo
    spawn bits::bitwise_and         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = res_maj, -8 = -1008 }
    sub t1_lo, res_maj
    ; T2 = S0(a) + Maj(a, b, c), with S0(a) = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
    fldiv rot_q0, a_hi, pow2                                ; rotr 2
    fldiv rot_q1, a_lo, pow2
    fldiv rot_q2, a_hi, pow13                               ; rotr 13
    fldiv rot_q3, a_lo, pow13
    fldiv rot_q4, a_lo, pow6                                ; rotr 22
    fldiv rot_q5, a_hi, pow6
    mov arg_x, a_lo                 | itemmod:16384
    sub arg_x, rot_q1               | itemmod:65536
    add arg_x, rot_q0
    mov arg_y, a_lo                 | itemmod:8
    sub arg_y, rot_q3               | itemmod:65536
    add arg_y, rot_q2
    mov arg_z, a_hi                 | itemmod:1024
    sub arg_z, rot_q5               | itemmod:65536
    add arg_z, rot_q4
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = sum_a, -9 = -1009 }
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = sum_a, c2 = arg_z, c3 = res_xor, -10 = -1010 }
    mov t2_hi, res_xor
    mov arg_x, a_hi                 | itemmod:16384
    sub arg_x, rot_q0               | itemmod:65536
    add arg_x, rot_q1
    mov arg_y, a_hi                 | itemmod:8
    sub arg_y, rot_q2               | itemmod:65536
    add arg_y, rot_q3
    mov arg_z, a_lo                 | itemmod:1024
    sub arg_z, rot_q4               | itemmod:65536
    add arg_z, rot_q5
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = sum_a, -11 = -1011 }
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = sum_a, c2 = arg_z, c3 = res_xor, -12 = -1012 }
    mov t2_lo, res_xor
    mov arg_x, a_hi
    mov arg_y, b_hi
    mov arg_z, c_hi
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = sum_a, -13 = -1013 }
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = sum_a, c2 = arg_z, c3 = res_xor, -14 = -1014 }
    add sum_b, arg_x, arg_y                                 ; Maj = (x + y + z - (x ^ y ^ z)) / 2
    add sum_b, arg_z
    sub sum_b, res_xor
    fldiv res_maj, sum_b, pow1
    add t2_hi, res_maj
    mov arg_x, a_lo
    mov arg_y, b_lo
    mov arg_z, c_lo
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = sum_a, -15 = -1015 }
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = sum_a, c2 = arg_z, c3 = res_xor, -16 = -1016 }
    add sum_b, arg_x, arg_y                                 ; Maj = (x + y + z - (x ^ y ^ z)) / 2
    add sum_b, arg_z
    sub sum_b, res_xor
    fldiv res_maj, sum_b, pow1
    add t2_lo, res_maj
    ; h = g, g = f, f = e, e = d + T1, d = c, c = b, b = a, a = T1 + T2
    mov h_hi, g_hi
    mov h_lo, g_lo
    mov g_hi, f_hi
    mov g_lo, f_lo
    mov f_hi, e_hi
    mov f_lo, e_lo
    add e_hi, d_hi, t1_hi
    add e_lo, d_lo, t1_lo
    fldiv carry, e_lo, pow16
    sub e_lo, carry                 | itemmod:65536
    add e_hi, carry                                         ; carry into the high half
    fldiv carry, e_hi, pow16
    sub e_hi, carry                 | itemmod:65536         ; mod 2^32
    mov d_hi, c_hi
    mov d_lo, c_lo
    mov c_hi, b_hi
    mov c_lo, b_lo
    mov b_hi, a_hi
    mov b_lo, a_lo
    add a_hi, t1_hi, t2_hi
    add a_lo, t1_lo, t2_lo
    fldiv carry, a_lo, pow16
    sub a_lo, carry                 | itemmod:65536
    add a_hi, carry                                         ; carry into the high half
    fldiv carry, a_hi, pow16
    sub a_hi, carry                 | itemmod:65536         ; mod 2^32
    ; W[t + 16] = s1(W[t + 14]) + W[t + 9] + s0(W[t + 1]) + W[t], with
    ; s0(x) = rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3), s1(x) = rotr(x, 17) ^ rotr(x, 19) ^ (x >> 10)
    add c1332, c1318, c1300
    add c1333, c1319, c1301
    fldiv rot_q0, c1302, pow7                               ; rotr 7
    fldiv rot_q1, c1303, pow7
    fldiv rot_q2, c1303, pow2                               ; rotr 18
    fldiv rot_q3, c1302, pow2
    fldiv rot_q4, c1302, pow3                               ; shr 3
    fldiv rot_q5, c1303, pow3
    mov arg_x, c1303                | itemmod:512
    sub arg_x, rot_q1               | itemmod:65536
    add arg_x, rot_q0
    mov arg_y, c1302                | itemmod:16384
    sub arg_y, rot_q3               | itemmod:65536
    add arg_y, rot_q2
    mov arg_z, rot_q4
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = sum_a, -17 = -1017 }
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = sum_a, c2 = arg_z, c3 = res_xor, -18 = -1018 }
    add c1332, res_xor
    mov arg_x, c1302                | itemmod:512
    sub arg_x, rot_q0               | itemmod:65536
    add arg_x, rot_q1
    mov arg_y, c1303                | itemmod:16384
    sub arg_y, rot_q2               | itemmod:65536
    add arg_y, rot_q3
    mov arg_z, c1302                | itemmod:8192
    sub arg_z, rot_q4               | itemmod:65536
    add arg_z, rot_q5
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = sum_a, -19 = -1019 }
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = sum_a, c2 = arg_z, c3 = res_xor, -20 = -1020 }
    add c1333, res_xor
    fldiv rot_q0, c1329, pow1                               ; rotr 17
    fldiv rot_q1, c1328, pow1
    fldiv rot_q2, c1329, pow3                               ; rotr 19
    fldiv rot_q3, c1328, pow3
    fldiv rot_q4, c1328, pow10                              ; shr 10
    fldiv rot_q5, c1329, pow10
    mov arg_x, c1328                | itemmod:32768
    sub arg_x, rot_q1               | itemmod:65536
    add arg_x, rot_q0
    mov arg_y, c1328                | itemmod:8192
    sub arg_y, rot_q3               | itemmod:65536
    add arg_y, rot_q2
    mov arg_z, rot_q4
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = sum_a, -21 = -1021 }
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = sum_a, c2 = arg_z, c3 = res_xor, -22 = -1022 }
    add c1332, res_xor
    mov arg_x, c1329                | itemmod:32768
    sub arg_x, rot_q0               | itemmod:65536
    add arg_x, rot_q1
    mov arg_y, c1329                | itemmod:8192
    sub arg_y, rot_q2               | itemmod:65536
    add arg_y, rot_q3
    mov arg_z, c1328                | itemmod:64
    sub arg_z, rot_q4               | itemmod:65536
    add arg_z, rot_q5
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = arg_x, c2 = arg_y, c3 = sum_a, -23 = -1023 }
    spawn bits::bitwise_xor         | ordered:false delay:0 remap: { c1 = sum_a, c2 = arg_z, c3 = res_xor, -24 = -1024 }
    add c1333, res_xor
    fldiv carry, c1333, pow16
    sub c1333, carry                | itemmod:65536
    add c1332, carry                                        ; carry into the high half
    fldiv carry, c1332, pow16
    sub c1332, carry                | itemmod:65536         ; mod 2^32
    ; move the schedule window and the constants along by one
    mov c1300, c1302
    mov c1301, c1303
    mov c1302, c1304
    mov c1303, c1305
    mov c1304, c1306
    mov c1305, c1307
    mov c1306, c1308
    mov c1307, c1309
    mov c1308, c1310
    mov c1309, c1311
    mov c1310, c1312
    mov c1311, c1313
    mov c1312, c1314
    mov c1313, c1315
    mov c1314, c1316
    mov c1315, c1317
    mov c1316, c1318
    mov c1317, c1319
    mov c1318, c1320
    mov c1319, c1321
    mov c1320, c1322
    mov c1321, c1323
    mov c1322, c1324
    mov c1323, c1325
    mov c1324, c1326
    mov c1325, c1327
    mov c1326, c1328
    mov c1327, c1329
    mov c1328, c1330
    mov c1329, c1331
    mov c1330, c1332
    mov c1331, c1333
    mov c1400, c1401
    mov c1401, c1402
    mov c1402, c1403
    mov c1403, c1404
    mov c1404, c1405
    mov c1405, c1406
    mov c1406, c1407
    mov c1407, c1408
    mov c1408, c1409
    mov c1409, c1410
    mov c1410, c1411
    mov c1411, c1412
    mov c1412, c1413
    mov c1413, c1414
    mov c1414, c1415
    mov c1415, c1416
    mov c1416, c1417
    mov c1417, c1418
    mov c1418, c1419
    mov c1419, c1420
    mov c1420, c1421
    mov c1421, c1422
    mov c1422, c1423
    mov c1423, c1424
    mov c1424, c1425
    mov c1425, c1426
    mov c1426, c1427
    mov c1427, c1428
    mov c1428, c1429
    mov c1429, c1430
    mov c1430, c1431
    mov c1431, c1432
    mov c1432, c1433
    mov c1433, c1434
    mov c1434, c1435
    mov c1435, c1436
    mov c1436, c1437
