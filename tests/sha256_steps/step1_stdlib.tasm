    add c1433, 1912
    mov c1434, 1294720000                                   ; K[34] = 0x4d2c6dfc
    add c1434, 37372
    mov c1435, 1396160000                                   ; K[35] = 0x53380d13
    add c1435, 22291
    mov c1436, 1695200000                                   ; K[36] = 0x650a7354
    add c1436, -16300
    mov c1437, 1986640000                                   ; K[37] = 0x766a0abb
    add c1437, 21051
    mov c1438, -2117920000                                  ; K[38] = 0x81c2c92e
    add c1438, -20946
    mov c1439, -1838000000                                  ; K[39] = 0x92722c85
    add c1439, -11259
    mov c1440, -1564480000                                  ; K[40] = 0xa2bfe8a1
    add c1440, -1375
