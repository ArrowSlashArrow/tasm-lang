; sha256 of the string starting at offset 100
_init:

    alias strlen, 50        ; maximum length: the string ends at its first 0 byte or after 50 bytes
    alias str_offset, 100

    ; the hash, one byte per counter (bottom display = first byte)
    display c20         ; expected: 49
    display c21         ; expected: 95
    display c22         ; expected: 91
    display c23         ; expected: 219
    display c24         ; expected: 118
    display c25         ; expected: 208
    display c26         ; expected: 120
    display c27         ; expected: 196
    display c28         ; expected: 59
    display c29         ; expected: 138
    display c30         ; expected: 192
    display c31         ; expected: 6
    display c32         ; expected: 78
    display c33         ; expected: 74
    display c34         ; expected: 1
    display c35         ; expected: 100
    display c36         ; expected: 97
    display c37         ; expected: 43
    display c38         ; expected: 31
    display c39         ; expected: 206
    display c40         ; expected: 119
    display c41         ; expected: 200
    display c42         ; expected: 105
    display c43         ; expected: 52
    display c44         ; expected: 91
    display c45         ; expected: 252
    display c46         ; expected: 148
    display c47         ; expected: 199
    display c48         ; expected: 88
    display c49         ; expected: 148
    display c50         ; expected: 237
    display c51         ; expected: 211

_start:
    ; load string: "Hello, world!"
    ; expected sha256 hash: 315f5bdb76d078c43b8ac0064e4a0164612b1fce77c869345bfc94c75894edd3
    mov C100, 72        ; H
    mov C101, 101       ; e
    mov C102, 108       ; l
    mov C103, 108       ; l
    mov C104, 111       ; o
    mov C105, 44        ; ,
    mov C106, 32        ; (space)
    mov C107, 119       ; w
    mov C108, 111       ; o
    mov C109, 114       ; r
    mov C110, 108       ; l
    mov C111, 100       ; d
    mov C112, 33        ; !
    spawn sha256                | ordered:false delay:0

; SHA-256 of the string at c100.. (bytes 0-255; it ends at its first 0 byte or after 50 bytes).
; The hash ends up in c20 - c51. Every 32-bit word is two counters (high and low 16 bits).
; c1200-c1208 / c1210-c1218: high / low halves of h, g, f, e, d, c, b, a, T1
; c1300-c1316 / c1320-c1336: W[t] .. W[t + 16], c1400-c1463: K[t] .. K[63] (signed)
; c3030-c3046: 2^0 .. 2^16, c3028: 0, c3100 and up: scratch and the helpers' arguments
; @0tick, but the rounds run afterwards, one per tick (64 ticks)
sha256:
    mov c3030, 1
    mov c3031, 2
    mov c3032, 4
    mov c3033, 8
    mov c3034, 16
    mov c3035, 32
    mov c3036, 64
    mov c3037, 128
    mov c3038, 256
    mov c3039, 512
    mov c3040, 1024
    mov c3041, 2048
    mov c3042, 4096
    mov c3043, 8192
    mov c3044, 16384
    mov c3045, 32768
    mov c3046, 65536
    mov c3028, 0
    mov c3029, 0                                    ; rounds done
    mov c3154, 1                                    ; alive: 1 until the string has ended
    mov c1335, 0                                    ; the length in bits
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c100, c3151 = c101, c3152 = c1300 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c102, c3151 = c103, c3152 = c1320 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c104, c3151 = c105, c3152 = c1301 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c106, c3151 = c107, c3152 = c1321 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c108, c3151 = c109, c3152 = c1302 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c110, c3151 = c111, c3152 = c1322 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c112, c3151 = c113, c3152 = c1303 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c114, c3151 = c115, c3152 = c1323 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c116, c3151 = c117, c3152 = c1304 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c118, c3151 = c119, c3152 = c1324 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c120, c3151 = c121, c3152 = c1305 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c122, c3151 = c123, c3152 = c1325 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c124, c3151 = c125, c3152 = c1306 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c126, c3151 = c127, c3152 = c1326 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c128, c3151 = c129, c3152 = c1307 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c130, c3151 = c131, c3152 = c1327 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c132, c3151 = c133, c3152 = c1308 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c134, c3151 = c135, c3152 = c1328 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c136, c3151 = c137, c3152 = c1309 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c138, c3151 = c139, c3152 = c1329 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c140, c3151 = c141, c3152 = c1310 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c142, c3151 = c143, c3152 = c1330 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c144, c3151 = c145, c3152 = c1311 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c146, c3151 = c147, c3152 = c1331 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c148, c3151 = c149, c3152 = c1312 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c3028, c3151 = c3028, c3152 = c1332 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c3028, c3151 = c3028, c3152 = c1313 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c3028, c3151 = c3028, c3152 = c1333 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c3028, c3151 = c3028, c3152 = c1314 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c3028, c3151 = c3028, c3152 = c1334 }
    spawn bytepair          | ordered:false delay:0 remap: { c3150 = c3028, c3151 = c3028, c3152 = c1315 }
    mov c1207, 27145                                ; a = 0x6a09e667
    mov c1217, 58983
    mov c1206, 47975                                ; b = 0xbb67ae85
    mov c1216, 44677
    mov c1205, 15470                                ; c = 0x3c6ef372
    mov c1215, 62322
    mov c1204, 42319                                ; d = 0xa54ff53a
    mov c1214, 62778
    mov c1203, 20750                                ; e = 0x510e527f
    mov c1213, 21119
    mov c1202, 39685                                ; f = 0x9b05688c
    mov c1212, 26764
    mov c1201, 8067                                 ; g = 0x1f83d9ab
    mov c1211, 55723
    mov c1200, 23520                                ; h = 0x5be0cd19
    mov c1210, 52505
    mov c1400, 1116340224                           ; K[0] = 0x428a2f98
    add c1400, 12184
    mov c1401, 1899429888                           ; K[1] = 0x71374491
    add c1401, 17553
    mov c1402, -1245708288                          ; K[2] = 0xb5c0fbcf
    add c1402, 64463
    mov c1403, -374013952                           ; K[3] = 0xe9b5dba5
    add c1403, 56229
    mov c1404, 961937408                            ; K[4] = 0x3956c25b
    add c1404, 49755
    mov c1405, 1508966400                           ; K[5] = 0x59f111f1
    add c1405, 4593
    mov c1406, -1841364992                          ; K[6] = 0x923f82a4
    add c1406, 33444
    mov c1407, -1424228352                          ; K[7] = 0xab1c5ed5
    add c1407, 24277
