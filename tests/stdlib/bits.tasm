; tests
; 587432 >> 3 == 73429
; 2 << 16 == 131072
; 3 >> 2 == 0
; 0 << 50 == 0

_init:
    import ../../stdlib/bits
    import ../../stdlib/debug

; --release
_start:
    mov c1, 587432    
    mov c2, 3    
    mov c3, 73429
    ; issue: we don't know when this returns
    spawn bits::slow_shift_right    | ordered:false remap: {core::return_signal = c5001}
    spawn core::wait_until          | ordered:false remap: {core::return_signal = c5001, g2 = continue_test}

continue_test:
    ; flashes green if we got here
    spawn debug::__true