; tests:
; 5 % 3 == 2
; 3 % 5 == 3
; 0 % 0 == 0
_init:
    import ../../stdlib/math
    import ../../stdlib/debug

; --release
_start:
    mov c1, 5
    mov c2, 3
    mov c4, 2
    spawn math::mod             | ordered:false
    spawn debug::assert_eq_int  | ordered:false remap: {1 = 3, 2 = 4}
    wait 120    ; wait 0.5s 

    mov c1, 3
    mov c2, 5
    mov c4, 3
    spawn math::mod             | ordered:false
    spawn debug::assert_eq_int  | ordered:false remap: {1 = 3, 2 = 4}
    wait 120    ; wait 0.5s 

    mov c1, 0
    mov c2, 0
    mov c4, 0
    spawn math::mod             | ordered:false
    spawn debug::assert_eq_int  | ordered:false remap: {1 = 3, 2 = 4}
