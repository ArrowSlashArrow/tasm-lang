
_init:
    import ../stdlib/mem_8bit
    display C20
    display mem_8bit::_std_mem_cmemreg
    display mem_8bit::_std_mem_ptrpos
    display mem_8bit::_std_mem_temp

; test program to check that memory works
_start:
    mov mem_8bit::_std_mem_ptrpos, 20
    mov C20, 5
    SPAWN mem_8bit::mem   | ordered:false remap: {mem_8bit::_std_mem_end = mem_8bit::_std_mem_cread}
