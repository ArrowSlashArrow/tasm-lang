; One round of the compression function, and the next word of the message schedule.
; not 0-tickable: loops by spawning itself (64 times, one tick each)
sha256_round:
    ; S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
    mov c1, sha_e
    mov c2, 6
    spawn rotr                  | ordered:false delay:0
    mov sha_x, c3
    mov c1, sha_e
    mov c2, 11
    spawn rotr                  | ordered:false delay:0
    mov sha_y, c3
    mov c1, sha_x
    mov c2, sha_y
    spawn xor32                 | ordered:false delay:0
    mov sha_x, c3
    mov c1, sha_e
    mov c2, 25
    spawn rotr                  | ordered:false delay:0
    mov sha_y, c3
    mov c1, sha_x
    mov c2, sha_y
    spawn xor32                 | ordered:false delay:0
    mov sha_s1, c3
    ; Ch = (e & f) ^ (~e & g) = g ^ (e & (f ^ g))
    mov c1, sha_f
    mov c2, sha_g
    spawn xor32                 | ordered:false delay:0
    mov c1, sha_e
    mov c2, c3
    spawn and32                 | ordered:false delay:0
    mov c1, sha_g
    mov c2, c3
    spawn xor32                 | ordered:false delay:0
    mov sha_ch, c3
    ; S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
    mov c1, sha_a
    mov c2, 2
    spawn rotr                  | ordered:false delay:0
    mov sha_x, c3
    mov c1, sha_a
    mov c2, 13
    spawn rotr                  | ordered:false delay:0
    mov sha_y, c3
    mov c1, sha_x
    mov c2, sha_y
    spawn xor32                 | ordered:false delay:0
    mov sha_x, c3
    mov c1, sha_a
    mov c2, 22
    spawn rotr                  | ordered:false delay:0
    mov sha_y, c3
    mov c1, sha_x
    mov c2, sha_y
    spawn xor32                 | ordered:false delay:0
    mov sha_s0, c3
    ; Maj = (a & b) ^ (a & c) ^ (b & c) = (a & b) + (c & (a ^ b)): the two parts have no bits
    ; in common, so adding them is the same as or-ing them, and can't leave the counter range
    mov c1, sha_a
    mov c2, sha_b
    spawn and32                 | ordered:false delay:0
    mov sha_maj, c3
    mov c1, sha_a
    mov c2, sha_b
    spawn xor32                 | ordered:false delay:0
    mov c1, sha_c
    mov c2, c3
    spawn and32                 | ordered:false delay:0
    add sha_maj, c3
    ; T1 = h + S1 + Ch + K[t] + W[t]
    mov c1, sha_h
    mov c2, sha_s1
    spawn add32                 | ordered:false delay:0
    mov c1, c3
    mov c2, sha_ch
    spawn add32                 | ordered:false delay:0
    mov c1, c3
    mov c2, c1400
    spawn add32                 | ordered:false delay:0
    mov c1, c3
    mov c2, c1300
    spawn add32                 | ordered:false delay:0
    mov sha_t1, c3
    ; h = g, g = f, f = e, e = d + T1, d = c, c = b, b = a, a = T1 + S0 + Maj
    mov sha_h, sha_g
    mov sha_g, sha_f
    mov sha_f, sha_e
    mov c1, sha_d
    mov c2, sha_t1
    spawn add32                 | ordered:false delay:0
    mov sha_e, c3
    mov sha_d, sha_c
    mov sha_c, sha_b
    mov sha_b, sha_a
    mov c1, sha_t1
    mov c2, sha_s0
    spawn add32                 | ordered:false delay:0
    mov c1, c3
    mov c2, sha_maj
    spawn add32                 | ordered:false delay:0
    mov sha_a, c3
    ; W[t + 16] = s1(W[t + 14]) + W[t + 9] + s0(W[t + 1]) + W[t], with
    ; s0(x) = rotr(x, 7) ^ rotr(x, 18) ^ (x >>> 3) and s1(x) = rotr(x, 17) ^ rotr(x, 19) ^ (x >>> 10)
    mov c1, c1301
    mov c2, 7
    spawn rotr                  | ordered:false delay:0
    mov sha_x, c3
    mov c1, c1301
    mov c2, 18
    spawn rotr                  | ordered:false delay:0
    mov sha_y, c3
    mov c1, sha_x
    mov c2, sha_y
    spawn xor32                 | ordered:false delay:0
    mov sha_x, c3
    mov c1, c1301
    mov c2, 3
    spawn bits::raw_shift_right | ordered:false delay:0
    mov sha_y, c3
    mov c1, sha_x
    mov c2, sha_y
    spawn xor32                 | ordered:false delay:0
    mov sha_s0, c3
    mov c1, c1314
    mov c2, 17
    spawn rotr                  | ordered:false delay:0
    mov sha_x, c3
    mov c1, c1314
    mov c2, 19
    spawn rotr                  | ordered:false delay:0
    mov sha_y, c3
    mov c1, sha_x
    mov c2, sha_y
    spawn xor32                 | ordered:false delay:0
    mov sha_x, c3
    mov c1, c1314
    mov c2, 10
    spawn bits::raw_shift_right | ordered:false delay:0
    mov sha_y, c3
    mov c1, sha_x
    mov c2, sha_y
    spawn xor32                 | ordered:false delay:0
    mov sha_s1, c3
    mov c1, sha_s1
    mov c2, c1309
    spawn add32                 | ordered:false delay:0
    mov c1, c3
    mov c2, sha_s0
    spawn add32                 | ordered:false delay:0
    mov c1, c3
    mov c2, c1300
    spawn add32                 | ordered:false delay:0
    mov sha_x, c3
