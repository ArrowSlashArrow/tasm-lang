    div c2426, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2426, c2425
    mov sha_tmp, c127           | resmode:+             ; byte 27
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2427, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2427, c2426
    mov sha_tmp, c128           | resmode:+             ; byte 28
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2428, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2428, c2427
    mov sha_tmp, c129           | resmode:+             ; byte 29
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2429, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2429, c2428
    mov sha_tmp, c130           | resmode:+             ; byte 30
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2430, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2430, c2429
    mov sha_tmp, c131           | resmode:+             ; byte 31
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2431, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2431, c2430
    mov sha_tmp, c132           | resmode:+             ; byte 32
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2432, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2432, c2431
    mov sha_tmp, c133           | resmode:+             ; byte 33
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2433, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2433, c2432
    mov sha_tmp, c134           | resmode:+             ; byte 34
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2434, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2434, c2433
    mov sha_tmp, c135           | resmode:+             ; byte 35
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2435, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2435, c2434
    mov sha_tmp, c136           | resmode:+             ; byte 36
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2436, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2436, c2435
    mov sha_tmp, c137           | resmode:+             ; byte 37
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2437, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2437, c2436
    mov sha_tmp, c138           | resmode:+             ; byte 38
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2438, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2438, c2437
    mov sha_tmp, c139           | resmode:+             ; byte 39
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2439, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2439, c2438
    mov sha_tmp, c140           | resmode:+             ; byte 40
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2440, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2440, c2439
    mov sha_tmp, c141           | resmode:+             ; byte 41
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2441, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2441, c2440
    mov sha_tmp, c142           | resmode:+             ; byte 42
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2442, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2442, c2441
    mov sha_tmp, c143           | resmode:+             ; byte 43
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2443, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2443, c2442
    mov sha_tmp, c144           | resmode:+             ; byte 44
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2444, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2444, c2443
    mov sha_tmp, c145           | resmode:+             ; byte 45
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2445, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2445, c2444
    mov sha_tmp, c146           | resmode:+             ; byte 46
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2446, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2446, c2445
    mov sha_tmp, c147           | resmode:+             ; byte 47
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2447, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2447, c2446
    mov sha_tmp, c148           | resmode:+             ; byte 48
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2448, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2448, c2447
    mov sha_tmp, c149           | resmode:+             ; byte 49
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2449, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2449, c2448
    ; the padded block: the string, then 0x80, then zeros, then the length in bits (bytes 62-63)
    mul c2300, c100, c2400                              ; byte 0
    mov sha_tmp, c2400          | itemmod:-1
    add sha_tmp, 1
    add c2300, sha_tmp          | itemmod:128
    mul c2301, c101, c2401                              ; byte 1
    sub sha_tmp, c2400, c2401
    add c2301, sha_tmp          | itemmod:128
    mul c2302, c102, c2402                              ; byte 2
    sub sha_tmp, c2401, c2402
    add c2302, sha_tmp          | itemmod:128
    mul c2303, c103, c2403                              ; byte 3
