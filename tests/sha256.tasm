; sha256 of the string starting at offset 100
_init:
    import ../stdlib/bits

    alias strlen, 50        ; maximum length: the string ends at its first 0 byte or after 50 bytes
    alias str_offset, 100

    ; working variables a..h
    alias sha_a,          c1200
    alias sha_b,          c1201
    alias sha_c,          c1202
    alias sha_d,          c1203
    alias sha_e,          c1204
    alias sha_f,          c1205
    alias sha_g,          c1206
    alias sha_h,          c1207
    alias sha_round,      c3000    ; rounds done
    alias sha_tmp,        c3001    ; scratch
    alias sha_den,        c3002    ; scratch
    alias sha_s1,         c3003    ; S1(e)
    alias sha_ch,         c3004    ; Ch(e, f, g)
    alias sha_s0,         c3005    ; S0(a)
    alias sha_maj,        c3006    ; Maj(a, b, c)
    alias sha_t1,         c3007    ; T1
    alias sha_x,          c3008    ; scratch word
    alias sha_y,          c3009    ; scratch word
    alias rot_n,          c3020    ; rotr: the rotation
    alias rot_hi,         c3021    ; rotr: c1 >>> n
    alias op_sa,          c3022    ; xor32/and32: -1 if c1 < 0
    alias op_sb,          c3023    ; xor32/and32: -1 if c2 < 0
    alias op_s,           c3024    ; xor32/and32: the sign bit of the result
    alias add_q,          c3025    ; add32: floor((c1 + c2) / 2^31)
    alias add_carry,      c3026    ; add32: 1, 0 or -1 times 2^32 to drop

    ; the hash, one byte per counter (bottom display = first byte)
    display c20         ; expected: 49
    display c21         ; expected: 95
    display c22         ; expected: 91
    display c23         ; expected: 219
    display c24         ; expected: 118
    display c25         ; expected: 208
    display c26         ; expected: 120
    display c27         ; expected: 196
    display c28         ; expected: 59
    display c29         ; expected: 138
    display c30         ; expected: 192
    display c31         ; expected: 6
    display c32         ; expected: 78
    display c33         ; expected: 74
    display c34         ; expected: 1
    display c35         ; expected: 100
    display c36         ; expected: 97
    display c37         ; expected: 43
    display c38         ; expected: 31
    display c39         ; expected: 206
    display c40         ; expected: 119
    display c41         ; expected: 200
    display c42         ; expected: 105
    display c43         ; expected: 52
    display c44         ; expected: 91
    display c45         ; expected: 252
    display c46         ; expected: 148
    display c47         ; expected: 199
    display c48         ; expected: 88
    display c49         ; expected: 148
    display c50         ; expected: 237
    display c51         ; expected: 211

_start:
    ; load string: "Hello, world!"
    ; expected sha256 hash: 315f5bdb76d078c43b8ac0064e4a0164612b1fce77c869345bfc94c75894edd3
    mov C100, 72        ; H
    mov C101, 101       ; e
    mov C102, 108       ; l
    mov C103, 108       ; l
    mov C104, 111       ; o
    mov C105, 44        ; ,
    mov C106, 32        ; (space)
    mov C107, 119       ; w
    mov C108, 111       ; o
    mov C109, 114       ; r
    mov C110, 108       ; l
    mov C111, 100       ; d
    mov C112, 33        ; !
    spawn sha256                | ordered:false delay:0

; SHA-256 of the string at c100.. (one byte per counter). The string ends at its first 0 byte
; or after 50 bytes, so it always fits in one 512-bit block. The 32 bytes of the hash end up
; in c20 - c51, most significant byte first.
;
; Every 32-bit word is one counter, holding the word's bits as a 32-bit two's complement integer
; (so words with the top bit set are negative). Item layout:
;     c1 - c3: arguments and results of xor32, and32, add32, rotr and the bits:: routines
;     c1200-c1207: the working variables a..h
;     c1300-c1315: the message schedule, W[t] .. W[t + 15]
;     c1400-c1463: the round constants that are still to come
;     c2300-c2363: the padded block, c2400-c2449: end-of-string flags
;     c3000-c3026: scratch
; @0tick, but the rounds run afterwards, one per tick (64 ticks)
sha256:
    mov sha_round, 0
    ; find the length: alive_i = 1 while bytes 0..i are all non-zero
    mov sha_tmp, c100           | resmode:+             ; byte 0
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2400, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mov sha_tmp, c101           | resmode:+             ; byte 1
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2401, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2401, c2400
    mov sha_tmp, c102           | resmode:+             ; byte 2
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2402, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2402, c2401
    mov sha_tmp, c103           | resmode:+             ; byte 3
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2403, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2403, c2402
    mov sha_tmp, c104           | resmode:+             ; byte 4
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2404, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2404, c2403
    mov sha_tmp, c105           | resmode:+             ; byte 5
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2405, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2405, c2404
    mov sha_tmp, c106           | resmode:+             ; byte 6
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2406, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2406, c2405
    mov sha_tmp, c107           | resmode:+             ; byte 7
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2407, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2407, c2406
    mov sha_tmp, c108           | resmode:+             ; byte 8
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2408, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2408, c2407
    mov sha_tmp, c109           | resmode:+             ; byte 9
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2409, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2409, c2408
    mov sha_tmp, c110           | resmode:+             ; byte 10
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2410, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2410, c2409
    mov sha_tmp, c111           | resmode:+             ; byte 11
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2411, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2411, c2410
    mov sha_tmp, c112           | resmode:+             ; byte 12
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2412, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2412, c2411
    mov sha_tmp, c113           | resmode:+             ; byte 13
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2413, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2413, c2412
    mov sha_tmp, c114           | resmode:+             ; byte 14
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2414, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2414, c2413
    mov sha_tmp, c115           | resmode:+             ; byte 15
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2415, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2415, c2414
    mov sha_tmp, c116           | resmode:+             ; byte 16
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2416, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2416, c2415
    mov sha_tmp, c117           | resmode:+             ; byte 17
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2417, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2417, c2416
    mov sha_tmp, c118           | resmode:+             ; byte 18
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2418, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2418, c2417
    mov sha_tmp, c119           | resmode:+             ; byte 19
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2419, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2419, c2418
    mov sha_tmp, c120           | resmode:+             ; byte 20
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2420, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2420, c2419
    mov sha_tmp, c121           | resmode:+             ; byte 21
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2421, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2421, c2420
    mov sha_tmp, c122           | resmode:+             ; byte 22
    mov sha_den, sha_tmp
