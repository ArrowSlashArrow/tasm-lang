; Returns `c1` ^ `c2` over all 32 bits, including the sign bit. bits::bitwise_xor ignores the
; sign bit, so the sign bits are taken off first, handled separately and put back afterwards.
; @param c1 the first word (changed)
; @param c2 the second word (changed)
; @returns c3 c1 ^ c2
; @0tick
xor32:
    mov op_sa, 0
    add op_sa, c1               | itemmod:2147483648 divmod:true finmode:floor ; -1 if c1 < 0, else 0
    mov op_sb, 0
    add op_sb, c2               | itemmod:2147483648 divmod:true finmode:floor
    sub c1, op_sa               | itemmod:2147483648    ; c1 without its sign bit: c1 + 2^31 if negative
    sub c2, op_sb               | itemmod:2147483648
    sub op_s, op_sa, op_sb      | resmode:+             ; sign bit: |sa - sb|
    spawn bits::bitwise_xor     | ordered:false delay:0
    sub c3, op_s                | itemmod:2147483648    ; put the sign bit back

; Returns `c1` & `c2` over all 32 bits, including the sign bit (see xor32).
; @param c1 the first word (changed)
; @param c2 the second word (changed)
; @returns c3 c1 & c2
; @0tick
and32:
    mov op_sa, 0
    add op_sa, c1               | itemmod:2147483648 divmod:true finmode:floor ; -1 if c1 < 0, else 0
    mov op_sb, 0
    add op_sb, c2               | itemmod:2147483648 divmod:true finmode:floor
    sub c1, op_sa               | itemmod:2147483648    ; c1 without its sign bit: c1 + 2^31 if negative
    sub c2, op_sb               | itemmod:2147483648
    mul op_s, op_sa, op_sb                              ; sign bit: sa * sb
    spawn bits::bitwise_and     | ordered:false delay:0
    sub c3, op_s                | itemmod:2147483648    ; put the sign bit back

; Returns `c1` rotated right by `c2` bits: (c1 >>> n) | (c1 << (32 - n)).
; @param c1 the word
; @param c2 the rotation, from 1 to 31 (changed)
; @returns c3 c1 rotated right by c2
; @0tick
rotr:
    spawn bits::raw_shift_right | ordered:false delay:0
    mov rot_hi, c3
    mov rot_n, c2
    mov c2, 32
    sub c2, rot_n
    spawn bits::raw_shift_left  | ordered:false delay:0
    add c3, rot_hi                                      ; no bits in common, so | is +, and the sum stays in range

; Returns `c1` + `c2` modulo 2^32, as a 32-bit two's complement integer (the carry out of the
; top bit is dropped). c1 + c2 itself may not fit in a counter, so it is never stored.
; @param c1 the first word
; @param c2 the second word
; @returns c3 c1 + c2, wrapped around
; @0tick
add32:
    mov add_q, 0
    add add_q, c1, c2           | iter:+ itemmod:2147483648 divmod:true finmode:floor ; -2 to 1
    mov add_carry, 0
    add add_carry, add_q        | itemmod:2 divmod:true finmode:ceil ; 1 if c1 + c2 >= 2^31, -1 if below -2^31, else 0
    mov c3, c2
    sub c3, add_carry           | itemmod:2147483648    ; c2 - carry * 2^31 fits in a counter,
    add c3, c1                                          ; and so does c1 + c2 - carry * 2^31,
    sub c3, add_carry           | itemmod:2147483648    ; and c1 + c2 - carry * 2^32
