    add c2341, sha_tmp          | itemmod:128
    mul c2342, c142, c2442                              ; byte 42
    sub sha_tmp, c2441, c2442
    add c2342, sha_tmp          | itemmod:128
    mul c2343, c143, c2443                              ; byte 43
    sub sha_tmp, c2442, c2443
    add c2343, sha_tmp          | itemmod:128
    mul c2344, c144, c2444                              ; byte 44
