; sha256 of the string starting at offset 100
_init:
    import ../stdlib/mem_14bit
    import ../stdlib/bits

    alias strlen, 50
    alias str_offset, 100

_start:
    ; load string: "Hello, world!"
    ; expected sha256 hash: 315f5bdb76d078c43b8ac0064e4a0164612b1fce77c869345bfc94c75894edd3
    mov C100, 72        ; H
    mov C101, 101       ; e
    mov C102, 108       ; l
    mov C103, 108       ; l
    mov C104, 111       ; o
    mov C105, 44        ; ,
    mov C106, 32        ; (space)
    mov C107, 119       ; w
    mov C108, 111       ; o
    mov C109, 114       ; r
    mov C110, 108       ; l
    mov C111, 100       ; d
    mov C112, 33        ; !