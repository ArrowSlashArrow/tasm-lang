    mul c1315, 256
    add c1315, c2363
    ; a..h = the initial hash values
    mov sha_a, 1779032064                               ; a = 0x6a09e667
    add sha_a, 1639
    mov sha_b, -1150832640                              ; b = 0xbb67ae85
    add sha_b, -379
    mov sha_c, 1013903360                               ; c = 0x3c6ef372
    add sha_c, 882
