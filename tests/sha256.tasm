    div c2423, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2423, c2422
    mov sha_tmp, c124           | resmode:+             ; byte 24
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2424, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2424, c2423
    mov sha_tmp, c125           | resmode:+             ; byte 25
    mov sha_den, sha_tmp
    add sha_den, 1
    div c2425, sha_tmp, sha_den | resmode:ceil          ; |x| / (|x| + 1) rounds up to 1 unless x is 0
    mul c2425, c2424
    mov sha_tmp, c126           | resmode:+             ; byte 26
