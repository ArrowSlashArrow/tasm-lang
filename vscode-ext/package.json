{
  "name": "tasm-lang-gd",
  "publisher": "ArrowSlashArrow",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/ArrowSlashArrow/tasm-lang"
  },
  "icon": "./img/tasm_logo.png",
  "displayName": ".tasm",
  "description": "VSCode support for Trigger Assembly (TASM) -- not Borland Turbo Assembler.",
  "version": "0.3.3",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./client/extension.js",
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "tasm",
        "aliases": [
          "Trigger Assembly",
          "tasm"
        ],
        "extensions": [
          ".tasm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./img/tasm_favicon.png",
          "dark": "./img/tasm_favicon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "tasm",
        "scopeName": "source.tasm",
        "path": "./syntaxes/tasm.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tasm",
        "path": "./snippets/tasm.json"
      }
    ],
    "commands": [
      {
        "command": "tasm.restartServer",
        "title": "TASM: Restart Language Server"
      },
      {
        "command": "tasm.compileGmd",
        "title": "Compile to .gmd",
        "category": "TASM"
      },
      {
        "command": "tasm.compileGmdRelease",
        "title": "Compile to .gmd (Release Mode)",
        "category": "TASM"
      },
      {
        "command": "tasm.compileGmdUnorderedStart",
        "title": "Compile to .gmd (Unordered Start)",
        "category": "TASM"
      },
      {
        "command": "tasm.compileClipboard",
        "title": "Compile to Clipboard",
        "category": "TASM"
      },
      {
        "command": "tasm.compileClipboardLens",
        "title": "Compile to Clipboard (No Entry Point)",
        "category": "TASM"
      }
    ],
    "configuration": {
      "title": "TASM",
      "properties": {
        "tasm.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the tasm-lsp executable. If empty, a bundled server, a build in the repository's tasm-lsp/target, or tasm-lsp on PATH is used."
        },
        "tasm.compiler.path": {
          "type": "string",
          "default": "",
          "description": "Path to the tasmc executable used by the compile commands. If empty, a build in the repository's rtasm/target, the installer's location (%APPDATA%\\tasm or ~/.local/bin/tasm), or tasmc on PATH is used."
        },
        "tasm.stdlibPath": {
          "type": "string",
          "default": "",
          "description": "Directory used for IMPORTSTD. If empty, the installer's location is used (%APPDATA%\\tasm\\stdlib or ~/.local/bin/tasm/stdlib)."
        },
        "tasm.diagnostics.requireEntryPoint": {
          "type": "boolean",
          "default": false,
          "description": "Report E0011 for files without a _start routine. Off by default because libraries don't have one."
        },
        "tasm.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "tasm.compileGmd",
          "when": "editorLangId == tasm"
        },
        {
          "command": "tasm.compileGmdRelease",
          "when": "editorLangId == tasm"
        },
        {
          "command": "tasm.compileGmdUnorderedStart",
          "when": "editorLangId == tasm"
        },
        {
          "command": "tasm.compileClipboard",
          "when": "editorLangId == tasm"
        },
        {
          "command": "tasm.compileClipboardLens",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "tasm.compileGmd",
          "when": "editorLangId == tasm",
          "group": "tasm@1"
        },
        {
          "command": "tasm.compileGmdRelease",
          "when": "editorLangId == tasm",
          "group": "tasm@2"
        },
        {
          "command": "tasm.compileGmdUnorderedStart",
          "when": "editorLangId == tasm",
          "group": "tasm@3"
        },
        {
          "command": "tasm.compileClipboard",
          "when": "editorLangId == tasm",
          "group": "tasm@4"
        }
      ],
      "explorer/context": [
        {
          "command": "tasm.compileGmd",
          "when": "resourceExtname == .tasm",
          "group": "tasm@1"
        },
        {
          "command": "tasm.compileGmdRelease",
          "when": "resourceExtname == .tasm",
          "group": "tasm@2"
        },
        {
          "command": "tasm.compileGmdUnorderedStart",
          "when": "resourceExtname == .tasm",
          "group": "tasm@3"
        },
        {
          "command": "tasm.compileClipboard",
          "when": "resourceExtname == .tasm",
          "group": "tasm@4"
        }
      ]
    }
  }
}
