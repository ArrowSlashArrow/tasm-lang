; TASM syntax highlighting test file
_init:
	IMPORT library
	importstd collections/list
	ALIAS start_value, 10
	alias temp_counter, c260
	DISPLAY C1 ; input value
	PERS C2
	IOBLOCK _start, 5, \g123
	COLL g50, COLL_P1, b3 | onexit:true

; a normal routine
fib:
	MOV C1, start_value
	ADD C1, 1
	MUL C2, C1, 2.5
	DIV C3, Cx56, 0x1F
	MOV T1, -1.5e3
	ADDM C1, C2, 3.0 | itemmod:0.4 divmod:false
	MOV C1, C1 | resmode:+ finmode:round-
	~MOV C2, 2
	SE routine1, C1, 0
	FGE next_iteration, prime, C3, C2
	ISRAND do_stuff, 42.8
	SPAWN mem_8bit::mem | ordered:false remap: {mem_8bit::mem_end = mem_8bit::cread}
	SPAWN fib | delay:0.5 remap: {1=129, 2:130}
	TSPAWN T1, 0, 10, gx56 | tpaused:true tmod:-1
	WAIT 2
	WAITS 0.5
	NOP
	MOV C1, ATTEMPTS
	SL fib, mem_8bit::ptrpos, MAX_INDEX ; loop
	RAW 1,1,2,45,3,15,57,2;
	RAWTRG 1,1,2,45,3,15,57,2; trailing comment
	UNKNOWNOP C1
