; This module defines implementations for branchless compares.
; The boolean gates (and, or, not, ...) use c9800-c9807 internally.

_init:
    alias __cs1, c9800                      ; scratch
    alias __cs2, c9801                      ; scratch
    alias __cs3, c9802                      ; scratch
    alias __cs4, c9803                      ; scratch
    alias __cs5, c9804                      ; scratch
    alias __a,   c9805                      ; c1 as a boolean
    alias __b,   c9806                      ; c2 as a boolean
    alias __t,   c9807

; todo:
; equals, nequals
; less, less_equals
; greater, greater_equals
; and float<comp>

; Returns `c1 > c2` as a boolean in `c3`. 
greater:
    sub c3, c1, c2  ; d
    mul c3, c3, 2   | resmode:+ iter:/
    add c3, 0.5

; Returns `c1 < c2` as a boolean in `c3`.
less:
    sub c3, c1, c2  ; d
    mul c3, c3, -2  | resmode:+ iter:/
    add c3, 0.5

; Returns `c1 <= c2` as a boolean in `c3`.
less_eq:
    sub c3, c1, c2  ; d
    mul c3, c3, 2   | resmode:+ iter:/
    mov c4, 0.5
    sub c3, c4, c3  | resmode:c

; Returns `c1` AND `c2` as a boolean (0 or 1) in `c3`. Any value other than 0 counts as true.
; @param c1 the first boolean
; @param c2 the second boolean
; @returns c3 `c1` AND `c2`
; @0tick
and:
    mov __a, 0                              ; __a = c1 != 0
    add __a, c1                 | resmode:+ itemmod:4294967296 divmod:true finmode:ceil
    mov __b, 0                              ; __b = c2 != 0
    add __b, c2                 | resmode:+ itemmod:4294967296 divmod:true finmode:ceil
    mul c3, __a, __b

; Returns `c1` OR `c2` as a boolean (0 or 1) in `c3`. Any value other than 0 counts as true.
; @param c1 the first boolean
; @param c2 the second boolean
; @returns c3 `c1` OR `c2`
; @0tick
or:
    mov __a, 0                              ; __a = c1 != 0
    add __a, c1                 | resmode:+ itemmod:4294967296 divmod:true finmode:ceil
    mov __b, 0                              ; __b = c2 != 0
    add __b, c2                 | resmode:+ itemmod:4294967296 divmod:true finmode:ceil
    add c3, __a, __b
    mul __t, __a, __b
    sub c3, __t                             ; a + b - ab

; Returns NOT `c1` as a boolean (0 or 1) in `c3`. Any value other than 0 counts as true.
; @param c1 the boolean
; @returns c3 NOT `c1`
; @0tick
not:
    mov __a, 0                              ; __a = c1 != 0
    add __a, c1                 | resmode:+ itemmod:4294967296 divmod:true finmode:ceil
    mov c3, __a                 | itemmod:-1                ; c3 = 1 - __a
    add c3, 1

; Returns NOT (`c1` AND `c2`) as a boolean (0 or 1) in `c3`. Any value other than 0 counts as true.
; @param c1 the first boolean
; @param c2 the second boolean
; @returns c3 NOT (`c1` AND `c2`)
; @0tick
nand:
    mov __a, 0                              ; __a = c1 != 0
    add __a, c1                 | resmode:+ itemmod:4294967296 divmod:true finmode:ceil
    mov __b, 0                              ; __b = c2 != 0
    add __b, c2                 | resmode:+ itemmod:4294967296 divmod:true finmode:ceil
    mul c3, __a, __b
    mul c3, -1
    add c3, 1

; Returns NOT (`c1` OR `c2`) as a boolean (0 or 1) in `c3`. Any value other than 0 counts as true.
; @param c1 the first boolean
; @param c2 the second boolean
; @returns c3 NOT (`c1` OR `c2`)
; @0tick
nor:
    mov __a, 0                              ; __a = c1 != 0
    add __a, c1                 | resmode:+ itemmod:4294967296 divmod:true finmode:ceil
    mov __b, 0                              ; __b = c2 != 0
    add __b, c2                 | resmode:+ itemmod:4294967296 divmod:true finmode:ceil
    add c3, __a, __b
    mul __t, __a, __b
    sub c3, __t                             ; a + b - ab
    mul c3, -1
    add c3, 1

; Returns `c1` XOR `c2` as a boolean (0 or 1) in `c3`. Any value other than 0 counts as true.
; @param c1 the first boolean
; @param c2 the second boolean
; @returns c3 `c1` XOR `c2`
; @0tick
xor:
    mov __a, 0                              ; __a = c1 != 0
    add __a, c1                 | resmode:+ itemmod:4294967296 divmod:true finmode:ceil
    mov __b, 0                              ; __b = c2 != 0
    add __b, c2                 | resmode:+ itemmod:4294967296 divmod:true finmode:ceil
    sub c3, __a, __b            | resmode:+                 ; |a - b|

; Returns NOT (`c1` XOR `c2`) as a boolean (0 or 1) in `c3`. Any value other than 0 counts as true.
; @param c1 the first boolean
; @param c2 the second boolean
; @returns c3 NOT (`c1` XOR `c2`)
; @0tick
xnor:
    mov __a, 0                              ; __a = c1 != 0
    add __a, c1                 | resmode:+ itemmod:4294967296 divmod:true finmode:ceil
    mov __b, 0                              ; __b = c2 != 0
    add __b, c2                 | resmode:+ itemmod:4294967296 divmod:true finmode:ceil
    sub c3, __a, __b            | resmode:+                 ; |a - b|
    mul c3, -1
    add c3, 1
