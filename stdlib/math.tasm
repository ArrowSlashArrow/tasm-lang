; __sincos_s = sin(__sincos_x), __sincos_c = cos(__sincos_x).
; Method: x = j * pi/2 + r with |r| <= pi/4, sin(r) and cos(r) from their Taylor series, then rotated by j quarter turns.
; Accurate to about 1e-7 for |x| up to a few thousand; the reduction loses precision for larger x.
; @param __sincos_x
; @returns __sincos_s, __sincos_c
; @0tick
__sincos:
    ; j = round(x / (pi/2))
    mov __k, 10680707                       ; 0.6366197724 * 2^24
    mul __sincos_jt, __sincos_x, __k | itemmod:16777216 divmod:true
    add __sincos_jt, 0.5
    mov __sincos_j, __sincos_jt | resmode:floor
    ; r = x - j * pi/2, with pi/2 in three parts
    mov __k, 201
    mul __sincos_g, __sincos_j, __k | itemmod:128 divmod:true ; j * 1.5703125
    sub __sincos_r, __sincos_x, __sincos_g
    mov __k, 4058
    mul __sincos_g, __sincos_j, __k | itemmod:8388608 divmod:true ; j * 4.837512969970703125e-4
    sub __sincos_r, __sincos_g
    mov __k, 10625385                       ; j * 7.549790e-08
    mul __sincos_g, __sincos_j, __k | itemmod:140737488355328 divmod:true
    sub __sincos_r, __sincos_g
    mul __sincos_r2, __sincos_r, __sincos_r
    mov __one, 1
    ; sin(r) = r(1 - r^2/(2*3)(1 - r^2/(4*5)(... (1 - r^2/(10*11)))))
    mov __sincos_sr, __sincos_r2 | itemmod:110 divmod:true
    sub __sincos_sr, __one, __sincos_sr
    mul __sincos_z, __sincos_sr, __sincos_r2 | itemmod:72 divmod:true
    sub __sincos_sr, __one, __sincos_z
    mul __sincos_z, __sincos_sr, __sincos_r2 | itemmod:42 divmod:true
    sub __sincos_sr, __one, __sincos_z
    mul __sincos_z, __sincos_sr, __sincos_r2 | itemmod:20 divmod:true
    sub __sincos_sr, __one, __sincos_z
    mul __sincos_z, __sincos_sr, __sincos_r2 | itemmod:6 divmod:true
    sub __sincos_sr, __one, __sincos_z
    mul __sincos_sr, __sincos_r
    ; cos(r) = 1 - r^2/(1*2)(1 - r^2/(3*4)(... (1 - r^2/(11*12))))
    mov __sincos_cr, __sincos_r2 | itemmod:132 divmod:true
    sub __sincos_cr, __one, __sincos_cr
    mul __sincos_z, __sincos_cr, __sincos_r2 | itemmod:90 divmod:true
    sub __sincos_cr, __one, __sincos_z
    mul __sincos_z, __sincos_cr, __sincos_r2 | itemmod:56 divmod:true
    sub __sincos_cr, __one, __sincos_z
    mul __sincos_z, __sincos_cr, __sincos_r2 | itemmod:30 divmod:true
    sub __sincos_cr, __one, __sincos_z
    mul __sincos_z, __sincos_cr, __sincos_r2 | itemmod:12 divmod:true
    sub __sincos_cr, __one, __sincos_z
    mul __sincos_z, __sincos_cr, __sincos_r2 | itemmod:2 divmod:true
    sub __sincos_cr, __one, __sincos_z
    ; q = j mod 4; cos(q pi/2) = |q - 2| - 1 and sin(q pi/2) = 1 - |q - 1| for q = 0..3
    mov __sincos_q, __sincos_j
    fldiv __sincos_q, 4
    mul __sincos_q, -4
    add __sincos_q, __sincos_j
    mov __sincos_a, __sincos_q
    sub __sincos_a, 2
    mov __sincos_a, __sincos_a  | resmode:+
    sub __sincos_a, 1
    mov __sincos_b, __sincos_q
    sub __sincos_b, 1
    mov __sincos_b, __sincos_b  | resmode:-
    add __sincos_b, 1
    ; sin(x) = a sin(r) + b cos(r), cos(x) = a cos(r) - b sin(r)
    mul __sincos_t1, __sincos_a, __sincos_sr
    mul __sincos_t2, __sincos_b, __sincos_cr
    add __sincos_s, __sincos_t1, __sincos_t2
    mul __sincos_t1, __sincos_a, __sincos_cr
    mul __sincos_t2, __sincos_b, __sincos_sr
    sub __sincos_c, __sincos_t1, __sincos_t2

; __atan_y = atan(__atan_x).
; Method: atan(x) = pi/2 - atan(1/x) for |x| > 1, atan(x) = pi/6 + atan((x sqrt(3) - 1) / (x + sqrt(3))) for x > tan(pi/12),
; then the series x - x^3/3 + x^5/5 - ... on |x| <= tan(pi/12).
; @param __atan_x
; @returns __atan_y
; @0tick
__atan:
    mov __atan_a, __atan_x      | resmode:+
    div __atan_sign, __atan_x, __atan_a     ; sign of x
    mov __atan_d, __atan_a
    sub __atan_d, 1
    mov __ts1, __atan_d         | resmode:+                 ; |x| > 1
    add __ts2, __atan_d, __ts1  | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __atan_inv, __ts2, __ts3 | resmode:ceil
    mul __atan_rec, __atan_inv, __atan_a
    add __atan_rec, 1
    sub __atan_rec, __atan_inv              ; |x| if |x| > 1, else 1, so that 1/rec is never huge
    mov __one, 1
    div __atan_rec, __one, __atan_rec
    mul __ts4, __atan_inv, __atan_rec       ; b = |x| <= 1 ? |x| : 1/|x|
    mul __ts5, __atan_inv, __atan_a
    sub __ts5, __atan_a, __ts5
    add __atan_b, __ts4, __ts5
    mov __k, 8990883                        ; tan(pi/12)
    mov __atan_const, __k       | itemmod:33554432 divmod:true
    sub __atan_d, __atan_b, __atan_const
    mov __ts1, __atan_d         | resmode:+                 ; b > tan(pi/12)
    add __ts2, __atan_d, __ts1  | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __atan_red, __ts2, __ts3 | resmode:ceil
    mov __k, 14529495                       ; __atan_const = 1.732050808
    mov __atan_const, __k       | itemmod:8388608 divmod:true
    mul __atan_num, __atan_b, __atan_const
    sub __atan_num, 1
    add __atan_den, __atan_b, __atan_const
    div __atan_num, __atan_den
    mul __ts4, __atan_red, __atan_num       ; __atan_c = __atan_red ? __atan_num : __atan_b
    mul __ts5, __atan_red, __atan_b
    sub __ts5, __atan_b, __ts5
    add __atan_c, __ts4, __ts5
    ; atan(c) = c(1 - c^2/3 + c^4/5 - ... - c^14/15), error below 2e-10
    mul __atan_cc, __atan_c, __atan_c
    mov __one, 1
    mov __atan_p, __one         | itemmod:-15 divmod:true
    mul __atan_p, __atan_cc
    add __atan_p, __one         | itemmod:13 divmod:true
    mul __atan_p, __atan_cc
    add __atan_p, __one         | itemmod:-11 divmod:true
    mul __atan_p, __atan_cc
    add __atan_p, __one         | itemmod:9 divmod:true
    mul __atan_p, __atan_cc
    add __atan_p, __one         | itemmod:-7 divmod:true
    mul __atan_p, __atan_cc
    add __atan_p, __one         | itemmod:5 divmod:true
    mul __atan_p, __atan_cc
    add __atan_p, __one         | itemmod:-3 divmod:true
    mul __atan_p, __atan_cc
    add __atan_p, __one
    mul __atan_p, __atan_c
    mov __k, 8784530                        ; __atan_const = 0.5235987756
    mov __atan_const, __k       | itemmod:16777216 divmod:true
    mul __atan_z, __atan_red, __atan_const
    add __atan_p, __atan_z
    mov __k, 13176795                       ; __atan_const = 1.570796327
    mov __atan_const, __k       | itemmod:8388608 divmod:true
    sub __atan_z, __atan_const, __atan_p
    mul __ts4, __atan_inv, __atan_z         ; __atan_p = __atan_inv ? __atan_z : __atan_p
    mul __ts5, __atan_inv, __atan_p
    sub __ts5, __atan_p, __ts5
    add __atan_p, __ts4, __ts5
    mul __atan_y, __atan_p, __atan_sign

; __atan2_out = atan2(__atan2_y, __atan2_x): the angle of the point (x, y), in (-pi, pi].
; Method: atan(min(|x|, |y|) / max(|x|, |y|)) never divides by a small number, then the quadrant is fixed up.
; @param __atan2_y
; @param __atan2_x
; @returns __atan2_out
; @0tick
__atan2:
    mov __atan2_ax, __atan2_x   | resmode:+
    mov __atan2_ay, __atan2_y   | resmode:+
    sub __atan2_d, __atan2_ay, __atan2_ax
    mov __ts1, __atan2_d        | resmode:+                 ; |y| > |x|
    add __ts2, __atan2_d, __ts1 | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __atan2_big, __ts2, __ts3 | resmode:ceil
    mul __ts4, __atan2_big, __atan2_ay      ; __atan2_max = __atan2_big ? __atan2_ay : __atan2_ax
    mul __ts5, __atan2_big, __atan2_ax
    sub __ts5, __atan2_ax, __ts5
    add __atan2_max, __ts4, __ts5
    mul __ts4, __atan2_big, __atan2_ax      ; __atan2_min = __atan2_big ? __atan2_ax : __atan2_ay
    mul __ts5, __atan2_big, __atan2_ay
    sub __ts5, __atan2_ay, __ts5
    add __atan2_min, __ts4, __ts5
    div __atan_x, __atan2_min, __atan2_max
    spawn __atan                | ordered:false delay:0
    mov __k, 13176795                       ; __atan2_const = 1.570796327
    mov __atan2_const, __k      | itemmod:8388608 divmod:true
    sub __atan2_z, __atan2_const, __atan_y
    mul __ts4, __atan2_big, __atan2_z       ; atan(|y| / |x|)
    mul __ts5, __atan2_big, __atan_y
    sub __ts5, __atan_y, __ts5
    add __atan2_base, __ts4, __ts5
    mov __ts1, __atan2_x        | resmode:+                 ; __atan2_sx = sign(__atan2_x) = __atan2_x / |__atan2_x|
    div __atan2_sx, __atan2_x, __ts1
    mov __ts1, __atan2_y        | resmode:+                 ; __atan2_sy = sign(__atan2_y) = __atan2_y / |__atan2_y|
    div __atan2_sy, __atan2_y, __ts1
    mul __atan2_base, __atan2_sx
    mul __atan2_base, __atan2_sy            ; atan(y / x)
    mov __ts1, __atan2_x        | resmode:+                 ; __atan2_xpos = __atan2_x > 0
    add __ts2, __atan2_x, __ts1 | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __atan2_xpos, __ts2, __ts3 | resmode:ceil
    mov __atan2_d, __atan2_x    | itemmod:-1
    mov __ts1, __atan2_d        | resmode:+                 ; __atan2_xneg = __atan2_d > 0
    add __ts2, __atan2_d, __ts1 | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __atan2_xneg, __ts2, __ts3 | resmode:ceil
    mov __atan2_xzero, 1
    sub __atan2_xzero, __atan2_xpos
    sub __atan2_xzero, __atan2_xneg         ; x == 0
    mov __atan2_d, __atan2_y    | itemmod:-1
    mov __ts1, __atan2_d        | resmode:+                 ; __atan2_yneg = __atan2_d > 0
    add __ts2, __atan2_d, __ts1 | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __atan2_yneg, __ts2, __ts3 | resmode:ceil
    mov __atan2_ys, __atan2_yneg | itemmod:-2
    add __atan2_ys, 1                       ; 1 if y >= 0, -1 if y < 0
    ; x > 0: atan(y/x). x < 0: atan(y/x) + pi (y >= 0) or - pi (y < 0). x == 0: sign(y) * pi/2
    mov __k, 13176795                       ; __atan2_const = 3.141592654
    mov __atan2_const, __k      | itemmod:4194304 divmod:true
    mul __atan2_z, __atan2_ys, __atan2_const
    add __atan2_z, __atan2_base
    mul __atan2_z, __atan2_xneg
    mul __atan2_out, __atan2_xpos, __atan2_base
    add __atan2_out, __atan2_z
    mov __k, 13176795                       ; __atan2_const = 1.570796327
    mov __atan2_const, __k      | itemmod:8388608 divmod:true
    mul __atan2_z, __atan2_sy, __atan2_const
    mul __atan2_z, __atan2_xzero
    add __atan2_out, __atan2_z

; __expm1_y = e^__expm1_x - 1, accurate also for x close to 0.
; Method: the Taylor series x(1 + x/2(1 + x/3(...))) for |x| < 1/2, e^x - 1 otherwise.
; @param __expm1_x
; @returns __expm1_y
; @0tick
__expm1:
    mov __expm1_a, __expm1_x    | resmode:+
    mov __expm1_d, __expm1_a    | itemmod:-1
    add __expm1_d, 0.5
    mov __ts1, __expm1_d        | resmode:+                 ; |x| < 1/2
    add __ts2, __expm1_d, __ts1 | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __expm1_small, __ts2, __ts3 | resmode:ceil
    mul __expm1_xs, __expm1_small, __expm1_x ; 0 when the series isn't used, so that it can't overflow
    mov __expm1_series, __expm1_xs | itemmod:10 divmod:true
    add __expm1_series, 1
    mul __expm1_series, __expm1_xs | itemmod:9 divmod:true
    add __expm1_series, 1
    mul __expm1_series, __expm1_xs | itemmod:8 divmod:true
    add __expm1_series, 1
    mul __expm1_series, __expm1_xs | itemmod:7 divmod:true
    add __expm1_series, 1
    mul __expm1_series, __expm1_xs | itemmod:6 divmod:true
    add __expm1_series, 1
    mul __expm1_series, __expm1_xs | itemmod:5 divmod:true
    add __expm1_series, 1
    mul __expm1_series, __expm1_xs | itemmod:4 divmod:true
    add __expm1_series, 1
    mul __expm1_series, __expm1_xs | itemmod:3 divmod:true
    add __expm1_series, 1
    mul __expm1_series, __expm1_xs | itemmod:2 divmod:true
    add __expm1_series, 1
    mul __expm1_series, __expm1_xs
    mov __exp_x, __expm1_x
    spawn __exp                 | ordered:false delay:0
    mov __expm1_big, __exp_y
    sub __expm1_big, 1
    mul __ts4, __expm1_small, __expm1_series ; __expm1_y = __expm1_small ? __expm1_series : __expm1_big
    mul __ts5, __expm1_small, __expm1_big
    sub __ts5, __expm1_big, __ts5
    add __expm1_y, __ts4, __ts5

; __log1p_y = ln(1 + __log1p_x), accurate also for x close to 0. Needs x > -1.
; Method: with u = 1 + x (rounded), ln(1 + x) = ln(u) * x / (u - 1), which cancels the rounding of u.
; @param __log1p_x
; @returns __log1p_y
; @0tick
__log1p:
    mov __log1p_u, __log1p_x
    add __log1p_u, 1
    mov __ln_x, __log1p_u
    spawn __ln                  | ordered:false delay:0
    mov __log1p_d, __log1p_u
    sub __log1p_d, 1
    div __log1p_w, __log1p_x, __log1p_d
    mul __log1p_w, __ln_y
    mov __ts1, __log1p_d        | resmode:+ itemmod:2 divmod:true ; u == 1 means x is too small to change 1, and ln(1 + x) = x
    mov __ts2, __ts1
    add __ts2, 1
    div __log1p_f, __ts1, __ts2 | resmode:ceil
    mul __ts4, __log1p_f, __log1p_w         ; __log1p_y = __log1p_f ? __log1p_w : __log1p_x
    mul __ts5, __log1p_f, __log1p_x
    sub __ts5, __log1p_x, __ts5
    add __log1p_y, __ts4, __ts5

; __hypot_y = sqrt(a^2 + b^2), without squaring large numbers.
; Method: max(|a|, |b|) * sqrt(1 + (min(|a|, |b|) / max(|a|, |b|))^2).
; @param __hypot_a
; @param __hypot_b
; @returns __hypot_y
; @0tick
__hypot:
    mov __hypot_aa, __hypot_a   | resmode:+
    mov __hypot_ab, __hypot_b   | resmode:+
    sub __hypot_d, __hypot_aa, __hypot_ab
    mov __ts1, __hypot_d        | resmode:+                 ; |a| > |b|
    add __ts2, __hypot_d, __ts1 | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __hypot_f, __ts2, __ts3 | resmode:ceil
    mul __ts4, __hypot_f, __hypot_aa        ; __hypot_max = __hypot_f ? __hypot_aa : __hypot_ab
    mul __ts5, __hypot_f, __hypot_ab
    sub __ts5, __hypot_ab, __ts5
    add __hypot_max, __ts4, __ts5
    mul __ts4, __hypot_f, __hypot_ab        ; __hypot_min = __hypot_f ? __hypot_ab : __hypot_aa
    mul __ts5, __hypot_f, __hypot_aa
    sub __ts5, __hypot_aa, __ts5
    add __hypot_min, __ts4, __ts5
    div __hypot_min, __hypot_max            ; ratio in [0, 1] (0 if both are 0)
    mul __sqrt_x, __hypot_min, __hypot_min
    add __sqrt_x, 1
    spawn __sqrt                | ordered:false delay:0
    mul __hypot_y, __hypot_max, __sqrt_y

; __cbrt_y = the cube root of __cbrt_x (negative for negative x).
; Method: 44 steps of Newton's method g = (2g + |x|/g^2) / 3, starting from |x| / 3 + 1.
; @param __cbrt_x
; @returns __cbrt_y
; @0tick
__cbrt:
    mov __cbrt_a, __cbrt_x      | resmode:+
    div __cbrt_sign, __cbrt_x, __cbrt_a     ; sign of x (0 for x = 0, which makes the result 0)
    mov __cbrt_g, __cbrt_a
    div __cbrt_g, 3
    add __cbrt_g, 1                         ; g = |x| / 3 + 1
    div __cbrt_q, __cbrt_a, __cbrt_g
    div __cbrt_q, __cbrt_g
    mul __cbrt_g, 2
    add __cbrt_g, __cbrt_q
    div __cbrt_g, 3
    div __cbrt_q, __cbrt_a, __cbrt_g
    div __cbrt_q, __cbrt_g
    mul __cbrt_g, 2
    add __cbrt_g, __cbrt_q
    div __cbrt_g, 3
