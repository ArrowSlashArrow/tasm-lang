; Math routines.
;
; Every routine takes its arguments in the lowest items (t1, t2, ... for real numbers, c1, c2, ... for
; integers) and returns its result in the next one, as documented above it. All of them can be
; 0-ticked, e.g.:
;     mov t1, 2
;     spawn math::sqrt  | ordered:false delay:0
;     mov t5, t2        ; t2 = 1.4142135
;
; They are branchless: no compares, so they use no extra groups. They use t9500-t9608 and c9500-c9569
; internally; don't use those items for anything else.
; Many routines spawn internal `__*` routines. When passing arguments with a remap, make sure
; that no remapped ID is the group of one of these routines (check with `tasmc -l`), since remaps
; apply to groups too.
;
; GD's arithmetic has float precision (about 7 significant digits), timers can't hold values above
; 9,999,999 and integer results are only exact below 16,777,216; the limits of each routine are
; listed with it.

_init:
    import core
    import compare

    alias __k,              c9500           ; integer part of the constant being loaded
    alias __one,            c9501           ; holds 1, for divisions of 1
    alias __ts1,            t9500           ; scratch
    alias __ts2,            t9501           ; scratch
    alias __ts3,            t9502           ; scratch
    alias __ts4,            t9503           ; scratch
    alias __ts5,            t9504           ; scratch
    alias __cs1,            c9502           ; scratch
    alias __cs2,            c9503           ; scratch
    alias __cs3,            c9504           ; scratch
    alias __cs4,            c9505           ; scratch
    alias __cs5,            c9506           ; scratch
    alias __exp_x,          t9505           ; input of __exp
    alias __exp_y,          t9506           ; output of __exp
    alias __exp_t,          t9507           ; clamped input
    alias __exp_d,          t9508
    alias __exp_g,          t9509
    alias __exp_kt,         t9510
    alias __exp_r,          t9511           ; reduced argument
    alias __exp_p,          t9512           ; e^r
    alias __exp_fac,        t9513
    alias __exp_f,          c9507
    alias __exp_k,          c9508           ; power of 2
    alias __exp_kp,         c9509
    alias __exp_kn,         c9510
    alias __exp_b,          c9511
    alias __exp_ifac,       c9512
    alias __ln_x,           t9514           ; input of __ln
    alias __ln_y,           t9515           ; output of __ln
    alias __ln_m,           t9516           ; mantissa
    alias __ln_d,           t9517
    alias __ln_g,           t9518
    alias __ln_lo,          t9519
    alias __ln_c,           t9520
    alias __ln_s,           t9521
    alias __ln_s2,          t9522
    alias __ln_p,           t9523
    alias __ln_f,           c9513
    alias __ln_fac,         c9514
    alias __ln_k,           c9515           ; exponent
    alias __sqrt_x,         t9524           ; input of __sqrt
    alias __sqrt_y,         t9525           ; output of __sqrt
    alias __sqrt_a,         t9526
    alias __sqrt_g,         t9527           ; current guess
    alias __sqrt_q,         t9528
    alias __sqrt_f,         c9516
    alias __sincos_x,       t9529           ; input of __sincos
    alias __sincos_s,       t9530           ; sine output of __sincos
    alias __sincos_c,       t9531           ; cosine output of __sincos
    alias __sincos_jt,      t9532
    alias __sincos_g,       t9533
    alias __sincos_r,       t9534           ; reduced argument
    alias __sincos_r2,      t9535
    alias __sincos_sr,      t9536           ; sin(r)
    alias __sincos_cr,      t9537           ; cos(r)
    alias __sincos_z,       t9538
    alias __sincos_t1,      t9539
    alias __sincos_t2,      t9540
    alias __sincos_j,       c9517           ; quarter turns
    alias __sincos_q,       c9518           ; quadrant
    alias __sincos_a,       c9519           ; cos(q * pi/2)
    alias __sincos_b,       c9520           ; sin(q * pi/2)
    alias __atan_x,         t9541           ; input of __atan
    alias __atan_y,         t9542           ; output of __atan
    alias __atan_a,         t9543
    alias __atan_sign,      t9544
    alias __atan_d,         t9545
    alias __atan_rec,       t9546
    alias __atan_b,         t9547
    alias __atan_const,     t9548
    alias __atan_num,       t9549
    alias __atan_den,       t9550
    alias __atan_c,         t9551
    alias __atan_cc,        t9552
    alias __atan_p,         t9553
    alias __atan_z,         t9554
    alias __atan_inv,       c9521
    alias __atan_red,       c9522
    alias __atan2_y,        t9555           ; first input (y) of __atan2
    alias __atan2_x,        t9556           ; second input (x) of __atan2
    alias __atan2_out,      t9557           ; output of __atan2
    alias __atan2_ax,       t9558
    alias __atan2_ay,       t9559
    alias __atan2_d,        t9560
    alias __atan2_max,      t9561
    alias __atan2_min,      t9562
    alias __atan2_base,     t9563
    alias __atan2_const,    t9564
    alias __atan2_z,        t9565
    alias __atan2_sx,       c9523
    alias __atan2_sy,       c9524
    alias __atan2_big,      c9525
    alias __atan2_xpos,     c9526
    alias __atan2_xneg,     c9527
    alias __atan2_xzero,    c9528
    alias __atan2_yneg,     c9529
    alias __atan2_ys,       c9530
    alias __expm1_x,        t9566           ; input of __expm1
    alias __expm1_y,        t9567           ; output of __expm1
    alias __expm1_a,        t9568
    alias __expm1_d,        t9569
    alias __expm1_xs,       t9570
    alias __expm1_series,   t9571
    alias __expm1_big,      t9572
    alias __expm1_small,    c9531
    alias __log1p_x,        t9573           ; input of __log1p
    alias __log1p_y,        t9574           ; output of __log1p
    alias __log1p_u,        t9575
    alias __log1p_d,        t9576
    alias __log1p_w,        t9577
    alias __log1p_f,        c9532
    alias __hypot_a,        t9578           ; first input of __hypot
    alias __hypot_b,        t9579           ; second input of __hypot
    alias __hypot_y,        t9580           ; output of __hypot
    alias __hypot_aa,       t9581
    alias __hypot_ab,       t9582
    alias __hypot_d,        t9583
    alias __hypot_max,      t9584
    alias __hypot_min,      t9585
    alias __hypot_f,        c9533
    alias __cbrt_x,         t9586           ; input of __cbrt
    alias __cbrt_y,         t9587           ; output of __cbrt
    alias __cbrt_a,         t9588
    alias __cbrt_sign,      t9589
    alias __cbrt_g,         t9590           ; current guess
    alias __cbrt_q,         t9591
    alias __pow_exponent,   t9592           ; t2, clamped
    alias __pow_d,          t9593
    alias __pow_g,          t9594
    alias __pow_res,        t9595
    alias __pow_f,          c9534
    alias __pow_floor,      c9535
    alias __pow_odd,        c9536
    alias __pow_neg,        c9537
    alias __pow_sign,       c9538
    alias __pow_nzb,        c9539
    alias __pow_nze,        c9540
    alias __pow_zb,         c9541
    alias __pow_ze,         c9542
    alias __asincos_x,      t9596           ; input of __asincos
    alias __asincos_s,      t9597           ; asin output of __asincos
    alias __asincos_c,      t9598           ; acos output of __asincos
    alias __asincos_t,      t9599
    alias __asincos_d,      t9600
    alias __asincos_g,      t9601
    alias __asincos_cos,    t9602
    alias __asincos_f,      c9543
    alias __hyp_a,          t9603
    alias __hyp_sign,       t9604
    alias __hyp_u,          t9605
    alias __hyp_v,          t9606
    alias __hyp_d,          t9607
    alias __hyp_f,          c9544
    alias __minmax_int_f,   c9545
    alias __clamp_int_t,    c9546
    alias __minmax_float_f, c9547
    alias __clamp_float_t,  t9608
    alias __gcd_a,          c9548
    alias __gcd_b,          c9549
    alias __gcd_q,          c9550
    alias __gcd_r,          c9551
    alias __gcd_f,          c9552
    alias __gcd_t,          c9553
    alias __ipow_e,         c9554
    alias __ipow_big,       c9555
    alias __ipow_parity,    c9556
    alias __ipow_bit,       c9557
    alias __ipow_fac,       c9558
    alias __ipow_res,       c9559
    alias __modpow_base,    c9560
    alias __modpow_e,       c9561
    alias __modpow_res,     c9562
    alias __modpow_q,       c9563
    alias __modpow_bit,     c9564
    alias __modpow_fac,     c9565
    alias __isqrt_n,        c9566
    alias __isqrt_res,      c9567
    alias __isqrt_cand,     c9568
    alias __isqrt_q,        c9569

; Returns a mod b.
; @param C1 a
; @param C2 b
; @returns C3
; @0tick
modulo:
    div c3, c1, c2  | resmode:f
    mul c3, c2
    sub c3, c1, c3

; Spawns `g1` if a mod b == 0, spawns `g2` if not.
; @param C1 a
; @param C2 b
; @param g3 spawned if a mod b == 0
; @param g4 spawned if a mod b != 0
; @0tick
modulo_fork:
    div c3, c1, c2  | resmode:f
    mul c3, c2  ; c1 == c3 is equivalent to c1 - c3 == 0 (c1 - c3 is a mod b)
    fe g1, g2, c1, c3


; TODO: implement these in branchless
; Returns the sign of `C1`. This function is branchless and uses 0 extra groups.
; @param C1 the value to get the sign of
; @returns The sign is returned in C2.
sign:
    ; load temp_regs (c2 = 0 for compares)
    mov c2, 0
    spawn compare::greater  | ordered:false delay:0 ;   no remap needed here; c1 => c1, c2 => c2
    mov c4, c3  ; save result
    spawn compare::less     | ordered:false delay:0 ;   no remap needed here; c1 => c1, c2 => c2
    sub c2, c4, c3  ; c2 = (0 < val) - (val < 0)

; Returns e raised to the power of `t1`.
; `t1` is clamped to [-87, 16.118], since larger results don't fit in a timer (9,999,999). Relative error about 1e-7.
; @param t1 the exponent
; @returns t2 e^t1
; @0tick
exp:
    mov __exp_x, t1
    spawn __exp                 | ordered:false delay:0
    mov t2, __exp_y

; Returns e^`t1` - 1. More accurate than `exp` minus 1 when `t1` is close to 0.
; @param t1 the exponent
; @returns t2 e^t1 - 1
; @0tick
expm1:
    mov __expm1_x, t1
    spawn __expm1               | ordered:false delay:0
    mov t2, __expm1_y

; Returns the natural logarithm of `t1`. `t1` must be positive (from about 1e-19 up).
; @param t1 the number
; @returns t2 ln(t1)
; @0tick
ln:
    mov __ln_x, t1
    spawn __ln                  | ordered:false delay:0
    mov t2, __ln_y

; Returns the base-2 logarithm of `t1`. `t1` must be positive.
; @param t1 the number
; @returns t2 log2(t1)
; @0tick
log2:
    mov __ln_x, t1
    spawn __ln                  | ordered:false delay:0
    mov __k, 12102203                       ; 1 / ln(2)
    mul t2, __ln_y, __k         | itemmod:8388608 divmod:true

; Returns the base-10 logarithm of `t1`. `t1` must be positive.
; @param t1 the number
; @returns t2 log10(t1)
; @0tick
log10:
    mov __ln_x, t1
    spawn __ln                  | ordered:false delay:0
    mov __k, 14572505                       ; 1 / ln(10)
    mul t2, __ln_y, __k         | itemmod:33554432 divmod:true

; Returns ln(1 + `t1`). More accurate than `ln` when `t1` is close to 0. `t1` must be greater than -1.
; @param t1 the number
; @returns t2 ln(1 + t1)
; @0tick
log1p:
    mov __log1p_x, t1
    spawn __log1p               | ordered:false delay:0
    mov t2, __log1p_y

; Returns the square root of `t1`. Negative values are treated as their absolute value.
; Accurate to the last digit for 1e-12 <= `t1` <= 9,999,999.
; @param t1 the number
; @returns t2 sqrt(t1)
; @0tick
sqrt:
    mov __sqrt_x, t1
    spawn __sqrt                | ordered:false delay:0
    mov t2, __sqrt_y

; Returns the cube root of `t1` (negative for negative `t1`).
; @param t1 the number
; @returns t2 the cube root of t1
; @0tick
cbrt:
    mov __cbrt_x, t1
    spawn __cbrt                | ordered:false delay:0
    mov t2, __cbrt_y

; Returns `t1` raised to the power of `t2`, computed as e^(t2 * ln|t1|).
; For negative `t1`, `t2` is rounded down for the sign (real powers of negative numbers aren't real).
; 0^0 is 1, 0^t2 is 0 otherwise. Results are limited like `exp` (at most 9,999,999). Relative error about 1e-6.
; @param t1 the base
; @param t2 the exponent
; @returns t3 t1^t2
; @0tick
pow:
    mov __ln_x, t1              | resmode:+
    spawn __ln                  | ordered:false delay:0
    ; clamp t2 to [-200000, 200000] so that t2 * ln|t1| can be stored; the result saturates long before
    mov __pow_d, t2             | resmode:+
    sub __pow_d, 200000
    mov __ts1, __pow_d          | resmode:+                 ; __pow_f = __pow_d > 0
    add __ts2, __pow_d, __ts1   | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __pow_f, __ts2, __ts3   | resmode:ceil
    mul __pow_g, __pow_f, __pow_d           ; how far |t2| is above the limit
    mov __ts1, t2               | resmode:+                 ; __pow_exponent = sign(t2) = t2 / |t2|
    div __pow_exponent, t2, __ts1
    mul __pow_g, __pow_exponent
    sub __pow_exponent, t2, __pow_g
    mul __exp_x, __pow_exponent, __ln_y
    spawn __exp                 | ordered:false delay:0
    ; sign: negative base and odd exponent
    mov __pow_floor, __pow_exponent | resmode:floor
    mov __pow_odd, __pow_floor
    fldiv __pow_odd, 2
    mul __pow_odd, -2
    add __pow_odd, __pow_floor              ; floor(t2) mod 2
    mov __pow_d, t1             | itemmod:-1
    mov __ts1, __pow_d          | resmode:+                 ; __pow_neg = __pow_d > 0
    add __ts2, __pow_d, __ts1   | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __pow_neg, __ts2, __ts3 | resmode:ceil
    mul __pow_sign, __pow_neg, __pow_odd
    mul __pow_sign, -2
    add __pow_sign, 1
    mul __pow_res, __exp_y, __pow_sign
    ; zero base
    mov __ts1, t1               | resmode:+ itemmod:2 divmod:true ; __pow_nzb = t1 != 0
    mov __ts2, __ts1
    add __ts2, 1
    div __pow_nzb, __ts1, __ts2 | resmode:ceil
    mov __ts1, t2               | resmode:+ itemmod:2 divmod:true ; __pow_nze = t2 != 0
    mov __ts2, __ts1
    add __ts2, 1
    div __pow_nze, __ts1, __ts2 | resmode:ceil
    mul __pow_res, __pow_nzb
    mov __pow_zb, __pow_nzb     | itemmod:-1                ; __pow_zb = 1 - __pow_nzb
    add __pow_zb, 1
    mov __pow_ze, __pow_nze     | itemmod:-1                ; __pow_ze = 1 - __pow_nze
    add __pow_ze, 1
    mul __pow_zb, __pow_ze                  ; 1 for 0^0
    add t3, __pow_res, __pow_zb

; Returns the sine of `t1` (in radians).
; Accurate to about 1e-7 for |`t1`| up to a few thousand.
; @param t1 the angle in radians
; @returns t2 sin(t1)
; @0tick
sin:
    mov __sincos_x, t1
    spawn __sincos              | ordered:false delay:0
    mov t2, __sincos_s

; Returns the cosine of `t1` (in radians).
; Accurate to about 1e-7 for |`t1`| up to a few thousand.
; @param t1 the angle in radians
; @returns t2 cos(t1)
; @0tick
cos:
    mov __sincos_x, t1
    spawn __sincos              | ordered:false delay:0
    mov t2, __sincos_c

; Returns the tangent of `t1` (in radians). Returns 0 where it is undefined (cos(t1) = 0 exactly).
; @param t1 the angle in radians
; @returns t2 tan(t1)
; @0tick
tan:
    mov __sincos_x, t1
    spawn __sincos              | ordered:false delay:0
    div t2, __sincos_s, __sincos_c

; Returns the cotangent of `t1` (in radians), 1 / tan(t1). Returns 0 where it is undefined.
; @param t1 the angle in radians
; @returns t2 cot(t1)
; @0tick
cot:
    mov __sincos_x, t1
    spawn __sincos              | ordered:false delay:0
    div t2, __sincos_c, __sincos_s

; Returns the secant of `t1` (in radians), 1 / cos(t1). Returns 0 where it is undefined.
; @param t1 the angle in radians
; @returns t2 sec(t1)
; @0tick
sec:
    mov __sincos_x, t1
    spawn __sincos              | ordered:false delay:0
    mov __one, 1
    div t2, __one, __sincos_c

; Returns the cosecant of `t1` (in radians), 1 / sin(t1). Returns 0 where it is undefined.
; @param t1 the angle in radians
; @returns t2 csc(t1)
; @0tick
csc:
    mov __sincos_x, t1
    spawn __sincos              | ordered:false delay:0
    mov __one, 1
    div t2, __one, __sincos_s

; Returns the arctangent of `t1`, in radians, in (-pi/2, pi/2).
; @param t1 the number
; @returns t2 atan(t1)
; @0tick
atan:
    mov __atan_x, t1
    spawn __atan                | ordered:false delay:0
    mov t2, __atan_y

; Returns the angle of the point (`t2`, `t1`) from the positive x axis, in radians, in (-pi, pi].
; Handles every quadrant and `t2` = 0; atan2(0, 0) is 0.
; @param t1 y
; @param t2 x
; @returns t3 atan2(t1, t2)
; @0tick
atan2:
    mov __atan2_y, t1
    mov __atan2_x, t2
    spawn __atan2               | ordered:false delay:0
    mov t3, __atan2_out

; Returns the arcsine of `t1`, in radians, in [-pi/2, pi/2]. `t1` is clamped to [-1, 1].
; @param t1 the number
; @returns t2 asin(t1)
; @0tick
asin:
    mov __asincos_x, t1
    spawn __asincos             | ordered:false delay:0
    mov t2, __asincos_s

; Returns the arccosine of `t1`, in radians, in [0, pi]. `t1` is clamped to [-1, 1].
; @param t1 the number
; @returns t2 acos(t1)
; @0tick
acos:
    mov __asincos_x, t1
    spawn __asincos             | ordered:false delay:0
    mov t2, __asincos_c

; Returns the arccosecant of `t1`, asin(1 / t1), in radians. |`t1`| should be at least 1; acsc(0) returns 0.
; @param t1 the number
; @returns t2 acsc(t1)
; @0tick
acsc:
    mov __one, 1
    div __asincos_x, __one, t1
    spawn __asincos             | ordered:false delay:0
    mov t2, __asincos_s

; Returns the arcsecant of `t1`, acos(1 / t1), in radians. |`t1`| should be at least 1; asec(0) returns pi/2.
; @param t1 the number
; @returns t2 asec(t1)
; @0tick
asec:
    mov __one, 1
    div __asincos_x, __one, t1
    spawn __asincos             | ordered:false delay:0
    mov t2, __asincos_c

; Returns the arccotangent of `t1`, pi/2 - atan(t1), in radians, in (0, pi).
; @param t1 the number
; @returns t2 acot(t1)
; @0tick
acot:
    mov __atan_x, t1
    spawn __atan                | ordered:false delay:0
    mov __k, 13176795                       ; t2 = 1.570796327
    mov t2, __k                 | itemmod:8388608 divmod:true
    sub t2, __atan_y

; Returns the hyperbolic sine of `t1`. Results are limited like `exp` (|`t1`| up to about 16.8).
; @param t1 the number
; @returns t2 sinh(t1)
; @0tick
sinh:
    mov __hyp_a, t1             | resmode:+
    div __hyp_sign, t1, __hyp_a             ; sign of t1
    mov __expm1_x, __hyp_a
    spawn __expm1               | ordered:false delay:0
    ; with u = e^|x| - 1: sinh|x| = (u + u / (u + 1)) / 2, without cancellation near 0
    mov __hyp_u, __expm1_y
    mov __hyp_v, __hyp_u
    add __hyp_v, 1
    div __hyp_v, __hyp_u, __hyp_v
    add __hyp_v, __hyp_u
    div __hyp_v, 2
    mul t2, __hyp_v, __hyp_sign

; Returns the hyperbolic cosine of `t1`. Results are limited like `exp` (|`t1`| up to about 16.8).
; @param t1 the number
; @returns t2 cosh(t1)
; @0tick
cosh:
    mov __exp_x, t1             | resmode:+
    spawn __exp                 | ordered:false delay:0
    mov __one, 1
    div __hyp_v, __one, __exp_y
    add __hyp_v, __exp_y
    mov t2, __hyp_v
    div t2, 2

; Returns the hyperbolic tangent of `t1`.
; @param t1 the number
; @returns t2 tanh(t1)
; @0tick
tanh:
    mov __hyp_a, t1             | resmode:+
    div __hyp_sign, t1, __hyp_a             ; sign of t1
    mov __hyp_d, __hyp_a
    sub __hyp_d, 9
    mov __ts1, __hyp_d          | resmode:+                 ; __hyp_f = __hyp_d > 0
    add __ts2, __hyp_d, __ts1   | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __hyp_f, __ts2, __ts3   | resmode:ceil
    mul __hyp_v, __hyp_f, __hyp_d
    sub __hyp_a, __hyp_v                    ; |x| = min(|x|, 9): tanh(9) rounds to 1
    mov __expm1_x, __hyp_a      | itemmod:2
    spawn __expm1               | ordered:false delay:0
    ; with u = e^(2|x|) - 1: tanh|x| = u / (u + 2)
    mov __hyp_v, __expm1_y
    add __hyp_v, 2
    div __hyp_v, __expm1_y, __hyp_v
    mul t2, __hyp_v, __hyp_sign

; Returns the inverse hyperbolic sine of `t1`.
; @param t1 the number
; @returns t2 asinh(t1)
; @0tick
asinh:
    mov __hyp_a, t1             | resmode:+
    div __hyp_sign, t1, __hyp_a             ; sign of t1
    mov __hypot_a, __hyp_a
    mov __hypot_b, 1
    spawn __hypot               | ordered:false delay:0
    ; asinh|x| = ln(|x| + sqrt(x^2 + 1)) = log1p(|x| + |x| * |x| / (1 + sqrt(x^2 + 1)))
    mov __hyp_v, __hypot_y
    add __hyp_v, 1
    div __hyp_v, __hyp_a, __hyp_v
    mul __hyp_v, __hyp_a
    add __log1p_x, __hyp_v, __hyp_a
