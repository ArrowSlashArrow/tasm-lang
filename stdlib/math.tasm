; __asincos_s = asin(x), __asincos_c = acos(x). x is clamped to [-1, 1].
; Method: with c = sqrt(1 - x^2), asin(x) = atan2(x, c) and acos(x) = atan2(c, x).
; @param __asincos_x
; @returns __asincos_s, __asincos_c
; @0tick
__asincos:
    mov __asincos_t, __asincos_x
    mov __asincos_d, __asincos_t
    sub __asincos_d, 1
    mov __ts1, __asincos_d      | resmode:+                 ; __asincos_f = __asincos_d > 0
    add __ts2, __asincos_d, __ts1 | itemmod:4 divmod:true   ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __asincos_f, __ts2, __ts3 | resmode:ceil
    mul __asincos_g, __asincos_f, __asincos_d
    sub __asincos_t, __asincos_g            ; x = min(x, 1)
    mov __asincos_d, __asincos_t | itemmod:-1
    sub __asincos_d, 1
    mov __ts1, __asincos_d      | resmode:+                 ; __asincos_f = __asincos_d > 0
    add __ts2, __asincos_d, __ts1 | itemmod:4 divmod:true   ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __asincos_f, __ts2, __ts3 | resmode:ceil
    mul __asincos_g, __asincos_f, __asincos_d
    add __asincos_t, __asincos_g            ; x = max(x, -1)
    mov __asincos_d, __asincos_t | itemmod:-1
    add __asincos_d, 1
    mov __asincos_g, __asincos_t
    add __asincos_g, 1
    mul __sqrt_x, __asincos_d, __asincos_g  ; (1 - x)(1 + x) = 1 - x^2, more precise near |x| = 1
    spawn __sqrt                | ordered:false delay:0
    mov __asincos_cos, __sqrt_y
    mov __atan2_y, __asincos_t
    mov __atan2_x, __asincos_cos
    spawn __atan2               | ordered:false delay:0
    mov __asincos_s, __atan2_out
    mov __atan2_y, __asincos_cos
    mov __atan2_x, __asincos_t
    spawn __atan2               | ordered:false delay:0
    mov __asincos_c, __atan2_out
