    add __isqrt_q, 1                        ; > 0 exactly when cand^2 <= n
    mov __cs1, __isqrt_q        | resmode:+                 ; __gcd_f = __isqrt_q > 0
    add __cs2, __isqrt_q, __cs1 | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __gcd_f, __cs2, __cs3   | resmode:ceil
    add __isqrt_res, __gcd_f    | itemmod:64
    mov __isqrt_cand, __isqrt_res
    add __isqrt_cand, 32                    ; try adding 2^5
    fldiv __isqrt_q, __isqrt_n, __isqrt_cand
    sub __isqrt_q, __isqrt_cand
    add __isqrt_q, 1                        ; > 0 exactly when cand^2 <= n
    mov __cs1, __isqrt_q        | resmode:+                 ; __gcd_f = __isqrt_q > 0
    add __cs2, __isqrt_q, __cs1 | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __gcd_f, __cs2, __cs3   | resmode:ceil
    add __isqrt_res, __gcd_f    | itemmod:32
    mov __isqrt_cand, __isqrt_res
    add __isqrt_cand, 16                    ; try adding 2^4
    fldiv __isqrt_q, __isqrt_n, __isqrt_cand
    sub __isqrt_q, __isqrt_cand
    add __isqrt_q, 1                        ; > 0 exactly when cand^2 <= n
    mov __cs1, __isqrt_q        | resmode:+                 ; __gcd_f = __isqrt_q > 0
    add __cs2, __isqrt_q, __cs1 | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __gcd_f, __cs2, __cs3   | resmode:ceil
    add __isqrt_res, __gcd_f    | itemmod:16
    mov __isqrt_cand, __isqrt_res
    add __isqrt_cand, 8                     ; try adding 2^3
    fldiv __isqrt_q, __isqrt_n, __isqrt_cand
    sub __isqrt_q, __isqrt_cand
    add __isqrt_q, 1                        ; > 0 exactly when cand^2 <= n
    mov __cs1, __isqrt_q        | resmode:+                 ; __gcd_f = __isqrt_q > 0
    add __cs2, __isqrt_q, __cs1 | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __gcd_f, __cs2, __cs3   | resmode:ceil
    add __isqrt_res, __gcd_f    | itemmod:8
    mov __isqrt_cand, __isqrt_res
    add __isqrt_cand, 4                     ; try adding 2^2
    fldiv __isqrt_q, __isqrt_n, __isqrt_cand
    sub __isqrt_q, __isqrt_cand
    add __isqrt_q, 1                        ; > 0 exactly when cand^2 <= n
    mov __cs1, __isqrt_q        | resmode:+                 ; __gcd_f = __isqrt_q > 0
    add __cs2, __isqrt_q, __cs1 | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __gcd_f, __cs2, __cs3   | resmode:ceil
    add __isqrt_res, __gcd_f    | itemmod:4
    mov __isqrt_cand, __isqrt_res
    add __isqrt_cand, 2                     ; try adding 2^1
    fldiv __isqrt_q, __isqrt_n, __isqrt_cand
    sub __isqrt_q, __isqrt_cand
    add __isqrt_q, 1                        ; > 0 exactly when cand^2 <= n
    mov __cs1, __isqrt_q        | resmode:+                 ; __gcd_f = __isqrt_q > 0
    add __cs2, __isqrt_q, __cs1 | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __gcd_f, __cs2, __cs3   | resmode:ceil
    add __isqrt_res, __gcd_f    | itemmod:2
    mov __isqrt_cand, __isqrt_res
    add __isqrt_cand, 1                     ; try adding 2^0
    fldiv __isqrt_q, __isqrt_n, __isqrt_cand
    sub __isqrt_q, __isqrt_cand
    add __isqrt_q, 1                        ; > 0 exactly when cand^2 <= n
    mov __cs1, __isqrt_q        | resmode:+                 ; __gcd_f = __isqrt_q > 0
    add __cs2, __isqrt_q, __cs1 | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __gcd_f, __cs2, __cs3   | resmode:ceil
    add __isqrt_res, __gcd_f    | itemmod:1
    mov c2, __isqrt_res

; ---- internal routines; don't spawn these directly ----

; __exp_y = e^__exp_x.
; The input is clamped to [-87, 16.118]: e^16.118 is just below the timer limit (9,999,999).
; Method: e^x = 2^k * e^r with k = round(x / ln 2) and |r| <= ln(2) / 2; e^r from its Taylor series.
; @param __exp_x
; @returns __exp_y
; @0tick
__exp:
    ; clamp x to [-87, 16.118]
    mov __exp_t, __exp_x
    mov __exp_d, __exp_t
    sub __exp_d, 16.118
    mov __ts1, __exp_d          | resmode:+                 ; __exp_f = __exp_d > 0
    add __ts2, __exp_d, __ts1   | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __exp_f, __ts2, __ts3   | resmode:ceil
    mul __exp_g, __exp_f, __exp_d
    sub __exp_t, __exp_g                    ; x = min(x, 16.118)
    mov __exp_d, __exp_t        | itemmod:-1
    add __exp_d, -87                        ; d = -87 - x
    mov __ts1, __exp_d          | resmode:+                 ; __exp_f = __exp_d > 0
    add __ts2, __exp_d, __ts1   | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __exp_f, __ts2, __ts3   | resmode:ceil
    mul __exp_g, __exp_f, __exp_d
    add __exp_t, __exp_g                    ; x = max(x, -87)
    ; k = round(x / ln 2)
    mov __k, 12102203                       ; 1.442695041 * 2^23
    mul __exp_kt, __exp_t, __k  | itemmod:8388608 divmod:true
    add __exp_kt, 0.5
    mov __exp_k, __exp_kt       | resmode:floor
    ; r = x - k * ln 2, with ln 2 split in two parts so that k * (high part) is exact
    mov __k, 22713
    mul __exp_g, __exp_k, __k   | itemmod:32768 divmod:true ; k * 0.693145751953125
    sub __exp_r, __exp_t, __exp_g
    mov __k, 12566158                       ; k * 1.428607e-06
    mul __exp_g, __exp_k, __k   | itemmod:8796093022208 divmod:true
    sub __exp_r, __exp_g
    ; e^r = 1 + r(1 + r/2(1 + r/3(... (1 + r/8)))), error below 2e-10
    mov __exp_p, __exp_r        | itemmod:8 divmod:true
    add __exp_p, 1
    mul __exp_p, __exp_r        | itemmod:7 divmod:true
    add __exp_p, 1
    mul __exp_p, __exp_r        | itemmod:6 divmod:true
    add __exp_p, 1
    mul __exp_p, __exp_r        | itemmod:5 divmod:true
    add __exp_p, 1
    mul __exp_p, __exp_r        | itemmod:4 divmod:true
    add __exp_p, 1
    mul __exp_p, __exp_r        | itemmod:3 divmod:true
    add __exp_p, 1
    mul __exp_p, __exp_r        | itemmod:2 divmod:true
    add __exp_p, 1
    mul __exp_p, __exp_r
    add __exp_p, 1
    ; multiply by 2^k one bit of k at a time, so that no step stores a value above the result
    mov __cs1, __exp_k          | resmode:+                 ; __exp_f = __exp_k > 0
    add __cs2, __exp_k, __cs1   | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __exp_f, __cs2, __cs3   | resmode:ceil
    mul __exp_kp, __exp_f, __exp_k          ; kp = max(k, 0), at most 24
    mov __exp_b, __exp_kp                   ; bit 16 of kp
    fldiv __exp_b, 16
    sub __exp_kp, __exp_b       | itemmod:16
    mov __exp_ifac, __exp_b     | itemmod:65535
    add __exp_ifac, 1                       ; 2^16 if the bit is set, else 1
    mul __exp_p, __exp_ifac
    mov __exp_b, __exp_kp                   ; bit 8 of kp
    fldiv __exp_b, 8
    sub __exp_kp, __exp_b       | itemmod:8
    mov __exp_ifac, __exp_b     | itemmod:255
    add __exp_ifac, 1                       ; 2^8 if the bit is set, else 1
    mul __exp_p, __exp_ifac
    mov __exp_b, __exp_kp                   ; bit 4 of kp
    fldiv __exp_b, 4
    sub __exp_kp, __exp_b       | itemmod:4
    mov __exp_ifac, __exp_b     | itemmod:15
    add __exp_ifac, 1                       ; 2^4 if the bit is set, else 1
    mul __exp_p, __exp_ifac
    mov __exp_b, __exp_kp                   ; bit 2 of kp
    fldiv __exp_b, 2
    sub __exp_kp, __exp_b       | itemmod:2
    mov __exp_ifac, __exp_b     | itemmod:3
    add __exp_ifac, 1                       ; 2^2 if the bit is set, else 1
    mul __exp_p, __exp_ifac
    mov __exp_b, __exp_kp                   ; bit 1 of kp
    fldiv __exp_b, 1
    sub __exp_kp, __exp_b       | itemmod:1
    mov __exp_ifac, __exp_b     | itemmod:1
    add __exp_ifac, 1                       ; 2^1 if the bit is set, else 1
    mul __exp_p, __exp_ifac
    mov __exp_kn, __exp_k       | itemmod:-1
    mov __cs1, __exp_kn         | resmode:+                 ; __exp_f = __exp_kn > 0
    add __cs2, __exp_kn, __cs1  | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __exp_f, __cs2, __cs3   | resmode:ceil
    mul __exp_kn, __exp_f                   ; kn = max(-k, 0), at most 126
    mov __exp_b, __exp_kn                   ; bit 64 of kn
    fldiv __exp_b, 64
    sub __exp_kn, __exp_b       | itemmod:64
    mov __exp_fac, __exp_b      | itemmod:-1                ; __exp_fac = 1 - __exp_b
    add __exp_fac, 1
    add __exp_fac, __exp_b      | itemmod:18446744073709551616 divmod:true ; 2^-64 if the bit is set, else 1
    mul __exp_p, __exp_fac
    mov __exp_b, __exp_kn                   ; bit 32 of kn
    fldiv __exp_b, 32
    sub __exp_kn, __exp_b       | itemmod:32
    mov __exp_fac, __exp_b      | itemmod:-1                ; __exp_fac = 1 - __exp_b
    add __exp_fac, 1
    add __exp_fac, __exp_b      | itemmod:4294967296 divmod:true ; 2^-32 if the bit is set, else 1
    mul __exp_p, __exp_fac
    mov __exp_b, __exp_kn                   ; bit 16 of kn
    fldiv __exp_b, 16
    sub __exp_kn, __exp_b       | itemmod:16
    mov __exp_fac, __exp_b      | itemmod:-1                ; __exp_fac = 1 - __exp_b
    add __exp_fac, 1
    add __exp_fac, __exp_b      | itemmod:65536 divmod:true ; 2^-16 if the bit is set, else 1
    mul __exp_p, __exp_fac
    mov __exp_b, __exp_kn                   ; bit 8 of kn
    fldiv __exp_b, 8
    sub __exp_kn, __exp_b       | itemmod:8
    mov __exp_fac, __exp_b      | itemmod:-1                ; __exp_fac = 1 - __exp_b
    add __exp_fac, 1
    add __exp_fac, __exp_b      | itemmod:256 divmod:true   ; 2^-8 if the bit is set, else 1
    mul __exp_p, __exp_fac
    mov __exp_b, __exp_kn                   ; bit 4 of kn
    fldiv __exp_b, 4
    sub __exp_kn, __exp_b       | itemmod:4
    mov __exp_fac, __exp_b      | itemmod:-1                ; __exp_fac = 1 - __exp_b
    add __exp_fac, 1
    add __exp_fac, __exp_b      | itemmod:16 divmod:true    ; 2^-4 if the bit is set, else 1
    mul __exp_p, __exp_fac
    mov __exp_b, __exp_kn                   ; bit 2 of kn
    fldiv __exp_b, 2
    sub __exp_kn, __exp_b       | itemmod:2
    mov __exp_fac, __exp_b      | itemmod:-1                ; __exp_fac = 1 - __exp_b
    add __exp_fac, 1
    add __exp_fac, __exp_b      | itemmod:4 divmod:true     ; 2^-2 if the bit is set, else 1
    mul __exp_p, __exp_fac
    mov __exp_b, __exp_kn                   ; bit 1 of kn
    fldiv __exp_b, 1
    sub __exp_kn, __exp_b       | itemmod:1
    mov __exp_fac, __exp_b      | itemmod:-1                ; __exp_fac = 1 - __exp_b
    add __exp_fac, 1
    add __exp_fac, __exp_b      | itemmod:2 divmod:true     ; 2^-1 if the bit is set, else 1
    mul __exp_p, __exp_fac
    mov __exp_y, __exp_p

; __ln_y = ln(__ln_x), for __ln_x > 0 (from about 1e-19 up).
; Method: x = m * 2^k with 1/sqrt(2) <= m <= sqrt(2), then ln(m) = 2 atanh((m - 1) / (m + 1)) from its series.
; @param __ln_x
; @returns __ln_y
; @0tick
__ln:
    mov __ln_m, __ln_x
    mov __ln_k, 0
    ; divide m by 2^v while m > 2^v, so that m <= 2
    mov __ln_d, __ln_m
    sub __ln_d, 65536
    mov __ts1, __ln_d           | resmode:+                 ; m > 2^16
    add __ts2, __ln_d, __ts1    | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __ln_f, __ts2, __ts3    | resmode:ceil
    mov __ln_fac, __ln_f        | itemmod:65535
    add __ln_fac, 1
    div __ln_m, __ln_fac
    add __ln_k, __ln_f          | itemmod:16
    mov __ln_d, __ln_m
    sub __ln_d, 256
    mov __ts1, __ln_d           | resmode:+                 ; m > 2^8
    add __ts2, __ln_d, __ts1    | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __ln_f, __ts2, __ts3    | resmode:ceil
    mov __ln_fac, __ln_f        | itemmod:255
    add __ln_fac, 1
    div __ln_m, __ln_fac
    add __ln_k, __ln_f          | itemmod:8
    mov __ln_d, __ln_m
    sub __ln_d, 16
    mov __ts1, __ln_d           | resmode:+                 ; m > 2^4
    add __ts2, __ln_d, __ts1    | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __ln_f, __ts2, __ts3    | resmode:ceil
    mov __ln_fac, __ln_f        | itemmod:15
    add __ln_fac, 1
    div __ln_m, __ln_fac
    add __ln_k, __ln_f          | itemmod:4
    mov __ln_d, __ln_m
    sub __ln_d, 4
    mov __ts1, __ln_d           | resmode:+                 ; m > 2^2
    add __ts2, __ln_d, __ts1    | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __ln_f, __ts2, __ts3    | resmode:ceil
    mov __ln_fac, __ln_f        | itemmod:3
    add __ln_fac, 1
    div __ln_m, __ln_fac
    add __ln_k, __ln_f          | itemmod:2
    mov __ln_d, __ln_m
    sub __ln_d, 2
    mov __ts1, __ln_d           | resmode:+                 ; m > 2^1
    add __ts2, __ln_d, __ts1    | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __ln_f, __ts2, __ts3    | resmode:ceil
    mov __ln_fac, __ln_f        | itemmod:1
    add __ln_fac, 1
    div __ln_m, __ln_fac
    add __ln_k, __ln_f          | itemmod:1
    ; multiply m by 2^v while m < 2^-v, so that m >= 1/2
    mov __ln_lo, 1
    div __ln_lo, 4294967296
    sub __ln_d, __ln_lo, __ln_m
    mov __ts1, __ln_d           | resmode:+                 ; m < 2^-32
    add __ts2, __ln_d, __ts1    | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __ln_f, __ts2, __ts3    | resmode:ceil
    mul __ln_g, __ln_f, __ln_m
    add __ln_m, __ln_g          | itemmod:4294967296
    sub __ln_m, __ln_g                      ; m = m * 2^32 if the flag is set
    sub __ln_k, __ln_f          | itemmod:32
    mov __ln_lo, 1
    div __ln_lo, 65536
    sub __ln_d, __ln_lo, __ln_m
    mov __ts1, __ln_d           | resmode:+                 ; m < 2^-16
    add __ts2, __ln_d, __ts1    | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __ln_f, __ts2, __ts3    | resmode:ceil
    mul __ln_g, __ln_f, __ln_m
    add __ln_m, __ln_g          | itemmod:65536
    sub __ln_m, __ln_g                      ; m = m * 2^16 if the flag is set
    sub __ln_k, __ln_f          | itemmod:16
    mov __ln_lo, 1
    div __ln_lo, 256
    sub __ln_d, __ln_lo, __ln_m
    mov __ts1, __ln_d           | resmode:+                 ; m < 2^-8
    add __ts2, __ln_d, __ts1    | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __ln_f, __ts2, __ts3    | resmode:ceil
    mul __ln_g, __ln_f, __ln_m
    add __ln_m, __ln_g          | itemmod:256
    sub __ln_m, __ln_g                      ; m = m * 2^8 if the flag is set
    sub __ln_k, __ln_f          | itemmod:8
    mov __ln_lo, 1
    div __ln_lo, 16
    sub __ln_d, __ln_lo, __ln_m
    mov __ts1, __ln_d           | resmode:+                 ; m < 2^-4
    add __ts2, __ln_d, __ts1    | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __ln_f, __ts2, __ts3    | resmode:ceil
    mul __ln_g, __ln_f, __ln_m
    add __ln_m, __ln_g          | itemmod:16
    sub __ln_m, __ln_g                      ; m = m * 2^4 if the flag is set
    sub __ln_k, __ln_f          | itemmod:4
    mov __ln_lo, 1
    div __ln_lo, 4
    sub __ln_d, __ln_lo, __ln_m
    mov __ts1, __ln_d           | resmode:+                 ; m < 2^-2
    add __ts2, __ln_d, __ts1    | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __ln_f, __ts2, __ts3    | resmode:ceil
    mul __ln_g, __ln_f, __ln_m
    add __ln_m, __ln_g          | itemmod:4
    sub __ln_m, __ln_g                      ; m = m * 2^2 if the flag is set
    sub __ln_k, __ln_f          | itemmod:2
    mov __ln_lo, 1
    div __ln_lo, 2
    sub __ln_d, __ln_lo, __ln_m
    mov __ts1, __ln_d           | resmode:+                 ; m < 2^-1
    add __ts2, __ln_d, __ts1    | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __ln_f, __ts2, __ts3    | resmode:ceil
    mul __ln_g, __ln_f, __ln_m
    add __ln_m, __ln_g          | itemmod:2
    sub __ln_m, __ln_g                      ; m = m * 2^1 if the flag is set
    sub __ln_k, __ln_f          | itemmod:1
    ; bring m into [1/sqrt(2), sqrt(2)]
    mov __k, 11863283                       ; __ln_c = 1.414213562
    mov __ln_c, __k             | itemmod:8388608 divmod:true
    sub __ln_d, __ln_m, __ln_c
    mov __ts1, __ln_d           | resmode:+                 ; m > sqrt(2)
    add __ts2, __ln_d, __ts1    | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __ln_f, __ts2, __ts3    | resmode:ceil
    mov __ln_fac, __ln_f
    add __ln_fac, 1
    div __ln_m, __ln_fac
    add __ln_k, __ln_f
    mov __k, 11863283                       ; __ln_c = 0.7071067812
    mov __ln_c, __k             | itemmod:16777216 divmod:true
    sub __ln_d, __ln_c, __ln_m
    mov __ts1, __ln_d           | resmode:+                 ; m < 1/sqrt(2)
    add __ts2, __ln_d, __ts1    | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __ln_f, __ts2, __ts3    | resmode:ceil
    mov __ln_fac, __ln_f
    add __ln_fac, 1
    mul __ln_m, __ln_fac
    sub __ln_k, __ln_f
    ; s = (m - 1) / (m + 1), |s| <= 0.172
    mov __ln_d, __ln_m
    sub __ln_d, 1
    mov __ln_g, __ln_m
    add __ln_g, 1
    div __ln_s, __ln_d, __ln_g
    mul __ln_s2, __ln_s, __ln_s
    ; ln(m) = 2s(1 + s^2/3 + s^4/5 + ... + s^10/11), error below 1e-9
    mov __one, 1
    mov __ln_p, __one           | itemmod:11 divmod:true
    mul __ln_p, __ln_s2
    add __ln_p, __one           | itemmod:9 divmod:true
    mul __ln_p, __ln_s2
    add __ln_p, __one           | itemmod:7 divmod:true
    mul __ln_p, __ln_s2
    add __ln_p, __one           | itemmod:5 divmod:true
    mul __ln_p, __ln_s2
    add __ln_p, __one           | itemmod:3 divmod:true
    mul __ln_p, __ln_s2
    add __ln_p, __one
    mul __ln_p, __ln_s
    mul __ln_p, 2
    ; ln(x) = k * ln 2 + ln(m), with ln 2 in two parts
    mov __k, 12566158                       ; k * 1.428607e-06
    mul __ln_g, __ln_k, __k     | itemmod:8796093022208 divmod:true
    add __ln_p, __ln_g
    mov __k, 22713
    mul __ln_g, __ln_k, __k     | itemmod:32768 divmod:true ; k * 0.693145751953125
    add __ln_y, __ln_p, __ln_g

; __sqrt_y = sqrt(|__sqrt_x|).
; Method: 30 steps of Newton's method g = (g + x/g) / 2, starting from (x + 1) / 2.
; Every guess after the first is >= sqrt(x), so the steps halve the guess until they converge quadratically.
; @param __sqrt_x
; @returns __sqrt_y
; @0tick
__sqrt:
    mov __sqrt_a, __sqrt_x      | resmode:+
    mov __sqrt_g, __sqrt_a
    div __sqrt_g, 2
    add __sqrt_g, 0.5                       ; g = (x + 1) / 2, without storing x + 1
    div __sqrt_q, __sqrt_a, __sqrt_g
    add __sqrt_g, __sqrt_q
    div __sqrt_g, 2
    div __sqrt_q, __sqrt_a, __sqrt_g
    add __sqrt_g, __sqrt_q
    div __sqrt_g, 2
