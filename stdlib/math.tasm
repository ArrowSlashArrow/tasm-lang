; @0tick
max_int:
    sub c3, c1, c2
    mov __cs1, c3               | resmode:+                 ; c1 > c2
    add __cs2, c3, __cs1        | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __minmax_int_f, __cs2, __cs3 | resmode:ceil
    mul __cs4, __minmax_int_f, c1           ; c3 = __minmax_int_f ? c1 : c2
