; Converts `t1` from radians to degrees.
; @param t1 the angle in radians
; @returns t2 the angle in degrees
; @0tick
rad_to_deg:
    mov __k, 15019745                       ; 180 / pi
    mul t2, t1, __k             | itemmod:262144 divmod:true

