; Returns the least common multiple of `c1` and `c2` (always >= 0; 0 if either is 0).
; Exact while all values stay below 16,777,216 (GD's arithmetic is only exact up to there).
; @param c1 the first integer
; @param c2 the second integer
; @returns c3 lcm(c1, c2)
; @0tick
lcm:
    spawn gcd                   | ordered:false delay:0
    mov __gcd_a, c1             | resmode:+
    div __gcd_a, c3                         ; |c1| / gcd, exact (0 if gcd is 0)
    mov __gcd_b, c2             | resmode:+
    mul c3, __gcd_a, __gcd_b

; Returns `c1` raised to the power of `c2`, for integers and `c2` >= 0 (negative exponents count as 0). 0^0 is 1.
; Results must fit in a counter; for bases other than -1, 0 and 1 that means exponents up to 31.
; Exact while all values stay below 16,777,216 (GD's arithmetic is only exact up to there).
; @param c1 the base
; @param c2 the exponent
; @returns c3 c1^c2
; @0tick
ipow:
    mov __cs1, c2               | resmode:+                 ; c2 > 0
    add __cs2, c2, __cs1        | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __gcd_f, __cs2, __cs3   | resmode:ceil
    mul __ipow_e, __gcd_f, c2               ; e = max(c2, 0)
    ; only bases -1, 0 and 1 allow exponents above 31, and for them only the parity matters: use 30 or 31
    mov __gcd_t, __ipow_e
    sub __gcd_t, 31
    mov __cs1, __gcd_t          | resmode:+                 ; e > 31
    add __cs2, __gcd_t, __cs1   | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __ipow_big, __cs2, __cs3 | resmode:ceil
    mov __ipow_parity, __ipow_e
    fldiv __ipow_parity, 2
    mul __ipow_parity, -2
    add __ipow_parity, __ipow_e             ; e mod 2
    mov __gcd_t, __ipow_e
    sub __gcd_t, 30
    sub __gcd_t, __ipow_parity
    mul __gcd_t, __ipow_big
    sub __ipow_e, __gcd_t
    ; square-and-multiply from the highest bit: every intermediate result is at most the final one
    mov __ipow_res, 1
    mul __ipow_res, __ipow_res
    mov __ipow_bit, __ipow_e                ; bit 16 of e
    fldiv __ipow_bit, 16
    sub __ipow_e, __ipow_bit    | itemmod:16
    mov __ipow_fac, c1
    sub __ipow_fac, 1
    mul __ipow_fac, __ipow_bit
    add __ipow_fac, 1                       ; c1 if the bit is set, else 1
    mul __ipow_res, __ipow_fac
    mul __ipow_res, __ipow_res
    mov __ipow_bit, __ipow_e                ; bit 8 of e
    fldiv __ipow_bit, 8
    sub __ipow_e, __ipow_bit    | itemmod:8
    mov __ipow_fac, c1
    sub __ipow_fac, 1
    mul __ipow_fac, __ipow_bit
    add __ipow_fac, 1                       ; c1 if the bit is set, else 1
    mul __ipow_res, __ipow_fac
    mul __ipow_res, __ipow_res
    mov __ipow_bit, __ipow_e                ; bit 4 of e
    fldiv __ipow_bit, 4
    sub __ipow_e, __ipow_bit    | itemmod:4
    mov __ipow_fac, c1
    sub __ipow_fac, 1
    mul __ipow_fac, __ipow_bit
    add __ipow_fac, 1                       ; c1 if the bit is set, else 1
    mul __ipow_res, __ipow_fac
    mul __ipow_res, __ipow_res
    mov __ipow_bit, __ipow_e                ; bit 2 of e
    fldiv __ipow_bit, 2
    sub __ipow_e, __ipow_bit    | itemmod:2
    mov __ipow_fac, c1
    sub __ipow_fac, 1
    mul __ipow_fac, __ipow_bit
    add __ipow_fac, 1                       ; c1 if the bit is set, else 1
    mul __ipow_res, __ipow_fac
    mul __ipow_res, __ipow_res
    mov __ipow_bit, __ipow_e                ; bit 1 of e
    fldiv __ipow_bit, 1
    sub __ipow_e, __ipow_bit    | itemmod:1
    mov __ipow_fac, c1
    sub __ipow_fac, 1
    mul __ipow_fac, __ipow_bit
    add __ipow_fac, 1                       ; c1 if the bit is set, else 1
    mul __ipow_res, __ipow_fac
    mov c3, __ipow_res

; Returns (`c1` ^ `c2`) mod `c3`, in [0, `c3`), for integers, `c2` >= 0 and `c3` >= 1.
; Exact while `c2` is below 16,777,216 and (`c3` - 1)^2 is too, i.e. for `c3` up to 4097.
; @param c1 the base
; @param c2 the exponent (negative counts as 0)
; @param c3 the modulus
; @returns c4 c1^c2 mod c3
; @0tick
modpow:
    mov __modpow_base, c1
    fldiv __modpow_q, __modpow_base, c3
    mul __modpow_q, c3
    sub __modpow_base, __modpow_q           ; __modpow_base mod c3
    mov __cs1, c2               | resmode:+                 ; c2 > 0
    add __cs2, c2, __cs1        | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __gcd_f, __cs2, __cs3   | resmode:ceil
    mul __modpow_e, __gcd_f, c2
    mov __modpow_res, 1
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    ; square-and-multiply over the 31 bits of the exponent, reducing after every product
    mul __modpow_res, __modpow_res          ; bit 30
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mov __modpow_bit, __modpow_e
    fldiv __modpow_bit, 1073741824
    sub __modpow_e, __modpow_bit | itemmod:1073741824
    mov __modpow_fac, __modpow_base
    sub __modpow_fac, 1
    mul __modpow_fac, __modpow_bit
    add __modpow_fac, 1
    mul __modpow_res, __modpow_fac
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mul __modpow_res, __modpow_res          ; bit 29
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mov __modpow_bit, __modpow_e
    fldiv __modpow_bit, 536870912
    sub __modpow_e, __modpow_bit | itemmod:536870912
    mov __modpow_fac, __modpow_base
    sub __modpow_fac, 1
    mul __modpow_fac, __modpow_bit
    add __modpow_fac, 1
    mul __modpow_res, __modpow_fac
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mul __modpow_res, __modpow_res          ; bit 28
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mov __modpow_bit, __modpow_e
    fldiv __modpow_bit, 268435456
    sub __modpow_e, __modpow_bit | itemmod:268435456
    mov __modpow_fac, __modpow_base
    sub __modpow_fac, 1
    mul __modpow_fac, __modpow_bit
    add __modpow_fac, 1
    mul __modpow_res, __modpow_fac
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mul __modpow_res, __modpow_res          ; bit 27
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mov __modpow_bit, __modpow_e
    fldiv __modpow_bit, 134217728
    sub __modpow_e, __modpow_bit | itemmod:134217728
    mov __modpow_fac, __modpow_base
    sub __modpow_fac, 1
    mul __modpow_fac, __modpow_bit
    add __modpow_fac, 1
    mul __modpow_res, __modpow_fac
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mul __modpow_res, __modpow_res          ; bit 26
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mov __modpow_bit, __modpow_e
    fldiv __modpow_bit, 67108864
    sub __modpow_e, __modpow_bit | itemmod:67108864
    mov __modpow_fac, __modpow_base
    sub __modpow_fac, 1
    mul __modpow_fac, __modpow_bit
    add __modpow_fac, 1
    mul __modpow_res, __modpow_fac
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mul __modpow_res, __modpow_res          ; bit 25
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mov __modpow_bit, __modpow_e
    fldiv __modpow_bit, 33554432
    sub __modpow_e, __modpow_bit | itemmod:33554432
    mov __modpow_fac, __modpow_base
    sub __modpow_fac, 1
    mul __modpow_fac, __modpow_bit
    add __modpow_fac, 1
    mul __modpow_res, __modpow_fac
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mul __modpow_res, __modpow_res          ; bit 24
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mov __modpow_bit, __modpow_e
    fldiv __modpow_bit, 16777216
    sub __modpow_e, __modpow_bit | itemmod:16777216
    mov __modpow_fac, __modpow_base
    sub __modpow_fac, 1
    mul __modpow_fac, __modpow_bit
    add __modpow_fac, 1
    mul __modpow_res, __modpow_fac
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mul __modpow_res, __modpow_res          ; bit 23
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mov __modpow_bit, __modpow_e
    fldiv __modpow_bit, 8388608
    sub __modpow_e, __modpow_bit | itemmod:8388608
    mov __modpow_fac, __modpow_base
    sub __modpow_fac, 1
    mul __modpow_fac, __modpow_bit
    add __modpow_fac, 1
    mul __modpow_res, __modpow_fac
    fldiv __modpow_q, __modpow_res, c3
    mul __modpow_q, c3
    sub __modpow_res, __modpow_q            ; __modpow_res mod c3
    mul __modpow_res, __modpow_res          ; bit 22
    fldiv __modpow_q, __modpow_res, c3
