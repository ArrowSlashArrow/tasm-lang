; Returns `c1` limited to the range [`c2`, `c3`].
; @param c1 the number
; @param c2 the lower bound
; @param c3 the upper bound (at least the lower bound)
; @returns c4 min(max(c1, c2), c3)
; @0tick
clamp_int:
    sub c4, c2, c1
    mov __cs1, c4               | resmode:+                 ; c1 < c2
    add __cs2, c4, __cs1        | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __minmax_int_f, __cs2, __cs3 | resmode:ceil
    mul __cs4, __minmax_int_f, c2           ; c4 = __minmax_int_f ? c2 : c1
