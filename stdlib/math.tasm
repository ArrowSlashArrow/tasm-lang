    mov __sqrt_x, __hyp_a
    add __sqrt_x, 2
    spawn __sqrt                | ordered:false delay:0
    mul __hyp_u, __sqrt_y
    add __log1p_x, __hyp_a, __hyp_u
    spawn __log1p               | ordered:false delay:0
    mov t2, __log1p_y

; Returns the inverse hyperbolic tangent of `t1`. |`t1`| must be less than 1.
; @param t1 the number
