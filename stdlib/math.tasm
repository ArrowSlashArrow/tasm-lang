    sub __hyp_a, 1
    mov __ts1, __hyp_a          | resmode:+                 ; __hyp_f = __hyp_a > 0
    add __ts2, __hyp_a, __ts1   | itemmod:4 divmod:true     ; max(d, 0) / 2
    mov __ts3, __ts2
    add __ts3, 1
    div __hyp_f, __ts2, __ts3   | resmode:ceil
    mul __hyp_a, __hyp_f                    ; t = max(x - 1, 0)
    ; acosh(x) = ln(x + sqrt(x^2 - 1)) = log1p(t + sqrt(t) * sqrt(t + 2))
