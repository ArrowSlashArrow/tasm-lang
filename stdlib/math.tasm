; Returns the integer square root of `c1`: the largest integer whose square is at most `c1`. Negative `c1` gives 0.
; Builds the result one bit at a time, from 2^15 down.
; Exact while all values stay below 16,777,216 (GD's arithmetic is only exact up to there).
; @param c1 the integer
; @returns c2 floor(sqrt(c1))
; @0tick
isqrt:
    mov __cs1, c1               | resmode:+                 ; c1 > 0
    add __cs2, c1, __cs1        | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __gcd_f, __cs2, __cs3   | resmode:ceil
    mul __isqrt_n, __gcd_f, c1              ; n = max(c1, 0)
    mov __isqrt_res, 0
    mov __isqrt_cand, __isqrt_res
    add __isqrt_cand, 32768                 ; try adding 2^15
    fldiv __isqrt_q, __isqrt_n, __isqrt_cand
    sub __isqrt_q, __isqrt_cand
    add __isqrt_q, 1                        ; > 0 exactly when cand^2 <= n
    mov __cs1, __isqrt_q        | resmode:+                 ; __gcd_f = __isqrt_q > 0
    add __cs2, __isqrt_q, __cs1 | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __gcd_f, __cs2, __cs3   | resmode:ceil
    add __isqrt_res, __gcd_f    | itemmod:32768
    mov __isqrt_cand, __isqrt_res
    add __isqrt_cand, 16384                 ; try adding 2^14
    fldiv __isqrt_q, __isqrt_n, __isqrt_cand
    sub __isqrt_q, __isqrt_cand
    add __isqrt_q, 1                        ; > 0 exactly when cand^2 <= n
    mov __cs1, __isqrt_q        | resmode:+                 ; __gcd_f = __isqrt_q > 0
    add __cs2, __isqrt_q, __cs1 | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __gcd_f, __cs2, __cs3   | resmode:ceil
    add __isqrt_res, __gcd_f    | itemmod:16384
    mov __isqrt_cand, __isqrt_res
    add __isqrt_cand, 8192                  ; try adding 2^13
    fldiv __isqrt_q, __isqrt_n, __isqrt_cand
    sub __isqrt_q, __isqrt_cand
    add __isqrt_q, 1                        ; > 0 exactly when cand^2 <= n
    mov __cs1, __isqrt_q        | resmode:+                 ; __gcd_f = __isqrt_q > 0
    add __cs2, __isqrt_q, __cs1 | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __gcd_f, __cs2, __cs3   | resmode:ceil
    add __isqrt_res, __gcd_f    | itemmod:8192
    mov __isqrt_cand, __isqrt_res
    add __isqrt_cand, 4096                  ; try adding 2^12
    fldiv __isqrt_q, __isqrt_n, __isqrt_cand
