; Bit operations. The bitwise_* routines use c9850-c9874 internally.

_init:
    import core

    alias __cs1,        c9850               ; scratch
    alias __cs2,        c9851               ; scratch
    alias __cs3,        c9852               ; scratch
    alias __cs4,        c9853               ; scratch
    alias __cs5,        c9854               ; scratch
    alias __and_a,      c9855               ; first input of __and
    alias __and_b,      c9856               ; second input of __and
    alias __and_y,      c9857               ; output of __and
    alias __a,          c9858
    alias __b,          c9859
    alias __bit_a,      c9860
    alias __bit_b,      c9861
    alias __p,          c9862
    alias __t,          c9863
    alias __shift_a,    c9864               ; |c1|
    alias __shift_n,    c9865               ; shift amount, clamped to [0, 30]
    alias __shift_zero, c9866               ; 1 if everything is shifted out (n >= 31)
    alias __shift_p,    c9867               ; 2^n
    alias __shift_q,    c9868               ; 2^(31 - n)
    alias __shift_m,    c9869
    alias __shift_k,    c9870               ; 1 if n == 0
    alias __shift_r,    c9871               ; result without the sign
    alias __shift_sign, c9872
    alias __shift_bit,  c9873
    alias __shift_fac,  c9874

; bitwise ops provided by @xtreme420 on discord.
; thread: https://discord.com/channels/1271838464702283796/1486082799546138834

; returns (c3): c1 & c2
and:
    mul c3, c1, c2

; returns (c3): c1 | c2
or:
    add c3, c1, c2  | itemmod:2 divmod:true resmode:c

; returns (c3): !c1
not:
    mov c3, c1
    sub c3, 1       | resmode:+

; returns (c3): !(c1 & c2)
nand:
    spawn and       | ordered:false
    spawn not       | ordered:false remap: {1 = 3}

; returns (c3): c1 ^ c2
xor:
    sub c3, c1, c2  | resmode:+

nor:
    spawn or        | ordered:false
    spawn not       | ordered:false remap: {1 = 3}

xnor:
    spawn xor       | ordered:false
    spawn not       | ordered:false remap: {1 = 3}

; todo: shift right, shift left

; shifts c1 right by c2 bits.
slow_shift_right:
    ; copy c2
    mov core::c3_temp, c2
    ifge __slow_shift_right_loop, core::return_with_signal, core::c3_temp, 0   | ordered:false
__slow_shift_right_loop:
    div c1, 2   | resmode:f
    sub core::c3_temp, 1
    fge __slow_shift_right_loop, core::return_with_signal, core::c3_temp, 0    | ordered:false

; shifts c1 right by c2 bits.
slow_shift_left:
    ; copy c2
    mov core::c3_temp, c2
    ifge __slow_shift_left_loop, core::return_with_signal, core::c3_temp, 0    | ordered:false
__slow_shift_left_loop:
    mul c1, 2
    sub core::c3_temp, 1
    fge __slow_shift_left_loop, core::return_with_signal, core::c3_temp, 0     | ordered:false

; Returns `c1` & `c2`, computed bit by bit. The sign bit is ignored: the operation works on |c1| and |c2|. GD's arithmetic is only exact up to 16,777,216, so larger values may lose their lowest bits.
; @param c1 the first integer
; @param c2 the second integer
; @returns c3 `c1` & `c2`
; @0tick
bitwise_and:
    mov __and_a, c1
    mov __and_b, c2
    spawn __and                 | ordered:false delay:0
    mov c3, __and_y

; Returns `c1` | `c2`, computed bit by bit. The sign bit is ignored: the operation works on |c1| and |c2|. GD's arithmetic is only exact up to 16,777,216, so larger values may lose their lowest bits.
; @param c1 the first integer
; @param c2 the second integer
; @returns c3 `c1` | `c2`
; @0tick
bitwise_or:
    mov __and_a, c1
    mov __and_b, c2
    spawn __and                 | ordered:false delay:0
    mov __t, c2                 | resmode:+
    sub __t, __and_y
    mov c3, c1                  | resmode:+
    add c3, __t                             ; a | b = a + (b - (a & b)), without overflowing

; Returns `c1` ^ `c2`, computed bit by bit. The sign bit is ignored: the operation works on |c1| and |c2|. GD's arithmetic is only exact up to 16,777,216, so larger values may lose their lowest bits.
; @param c1 the first integer
; @param c2 the second integer
; @returns c3 `c1` ^ `c2`
; @0tick
bitwise_xor:
    mov __and_a, c1
    mov __and_b, c2
    spawn __and                 | ordered:false delay:0
    mov c3, c1                  | resmode:+
    sub c3, __and_y
    mov __t, c2                 | resmode:+
    sub __t, __and_y
    add c3, __t                             ; a ^ b = (a - (a & b)) + (b - (a & b))

; Returns `c1` shifted left by `c2` bits: |`c1`| * 2^`c2`, keeping only the 31 bits below the sign bit
; (bits shifted past bit 30 are dropped instead of overflowing). Branchless version of `slow_shift_left`.
; Only the 31 bits below the sign bit are shifted: the shift works on |`c1`| and the result gets the sign of `c1`. GD's arithmetic is only exact up to 16,777,216, so larger values may lose their lowest bits.
; @param c1 the integer
; @param c2 the number of bits (negative counts as 0; 31 or more gives 0)
; @returns c3 c1 << c2
; @0tick
fast_shift_left:
    mov __shift_a, c1           | resmode:+
    div __shift_sign, c1, __shift_a         ; sign of c1 (0 for 0)
    mov __cs1, c2               | resmode:+                 ; c2 > 0
    add __cs2, c2, __cs1        | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __shift_n, __cs2, __cs3 | resmode:ceil
    mul __shift_n, c2                       ; n = max(c2, 0)
    mov __t, __shift_n
    sub __t, 30
    mov __cs1, __t              | resmode:+                 ; n > 30: every bit is shifted out
    add __cs2, __t, __cs1       | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __shift_zero, __cs2, __cs3 | resmode:ceil
    mul __t, __shift_zero
    sub __shift_n, __t                      ; n = min(n, 30)
    ; drop the bits that would pass bit 30: keep |c1| mod 2^(31 - n). For n = 0, 2^31 doesn't
    ; fit in a counter, so 2^30 is used and the unshifted value is chosen at the end instead
    mov __cs1, __shift_n        | resmode:+                 ; __shift_k = __shift_n != 0
    mov __cs2, __cs1
    add __cs2, 1
    div __shift_k, __cs1, __cs2 | resmode:ceil
    mov __shift_k, __shift_k    | itemmod:-1                ; __shift_k = 1 - __shift_k
    add __shift_k, 1
    mov __shift_m, __shift_n    | itemmod:-1
    add __shift_m, 31
    sub __shift_m, __shift_k                ; 31 - n, or 30 for n = 0
    mov __shift_q, 1
    mov __shift_bit, __shift_m              ; bit 16 of the exponent
    fldiv __shift_bit, 16
    sub __shift_m, __shift_bit  | itemmod:16
    mov __shift_fac, __shift_bit | itemmod:65535
    add __shift_fac, 1                      ; 2^16 if the bit is set, else 1
    mul __shift_q, __shift_fac
    mov __shift_bit, __shift_m              ; bit 8 of the exponent
    fldiv __shift_bit, 8
    sub __shift_m, __shift_bit  | itemmod:8
    mov __shift_fac, __shift_bit | itemmod:255
    add __shift_fac, 1                      ; 2^8 if the bit is set, else 1
    mul __shift_q, __shift_fac
    mov __shift_bit, __shift_m              ; bit 4 of the exponent
    fldiv __shift_bit, 4
    sub __shift_m, __shift_bit  | itemmod:4
    mov __shift_fac, __shift_bit | itemmod:15
    add __shift_fac, 1                      ; 2^4 if the bit is set, else 1
    mul __shift_q, __shift_fac
    mov __shift_bit, __shift_m              ; bit 2 of the exponent
    fldiv __shift_bit, 2
    sub __shift_m, __shift_bit  | itemmod:2
    mov __shift_fac, __shift_bit | itemmod:3
    add __shift_fac, 1                      ; 2^2 if the bit is set, else 1
    mul __shift_q, __shift_fac
    mov __shift_bit, __shift_m              ; bit 1 of the exponent
    fldiv __shift_bit, 1
    sub __shift_m, __shift_bit  | itemmod:1
    mov __shift_fac, __shift_bit | itemmod:1
    add __shift_fac, 1                      ; 2^1 if the bit is set, else 1
    mul __shift_q, __shift_fac
    fldiv __shift_r, __shift_a, __shift_q
    mul __shift_r, __shift_q
    sub __shift_r, __shift_a, __shift_r     ; |c1| mod 2^(31 - n)
    mov __shift_m, __shift_n
    mov __shift_p, 1
    mov __shift_bit, __shift_m              ; bit 16 of the exponent
    fldiv __shift_bit, 16
    sub __shift_m, __shift_bit  | itemmod:16
    mov __shift_fac, __shift_bit | itemmod:65535
    add __shift_fac, 1                      ; 2^16 if the bit is set, else 1
    mul __shift_p, __shift_fac
    mov __shift_bit, __shift_m              ; bit 8 of the exponent
    fldiv __shift_bit, 8
    sub __shift_m, __shift_bit  | itemmod:8
    mov __shift_fac, __shift_bit | itemmod:255
    add __shift_fac, 1                      ; 2^8 if the bit is set, else 1
    mul __shift_p, __shift_fac
    mov __shift_bit, __shift_m              ; bit 4 of the exponent
    fldiv __shift_bit, 4
    sub __shift_m, __shift_bit  | itemmod:4
    mov __shift_fac, __shift_bit | itemmod:15
    add __shift_fac, 1                      ; 2^4 if the bit is set, else 1
    mul __shift_p, __shift_fac
    mov __shift_bit, __shift_m              ; bit 2 of the exponent
    fldiv __shift_bit, 2
    sub __shift_m, __shift_bit  | itemmod:2
    mov __shift_fac, __shift_bit | itemmod:3
    add __shift_fac, 1                      ; 2^2 if the bit is set, else 1
    mul __shift_p, __shift_fac
    mov __shift_bit, __shift_m              ; bit 1 of the exponent
    fldiv __shift_bit, 1
    sub __shift_m, __shift_bit  | itemmod:1
    mov __shift_fac, __shift_bit | itemmod:1
    add __shift_fac, 1                      ; 2^1 if the bit is set, else 1
    mul __shift_p, __shift_fac
    mul __shift_r, __shift_p                ; the kept bits, shifted: below 2^31
    mul __cs4, __shift_k, __shift_a         ; n = 0: |c1| unchanged
    mul __cs5, __shift_k, __shift_r
    sub __cs5, __shift_r, __cs5
    add __shift_r, __cs4, __cs5
    mov __t, __shift_zero       | itemmod:-1                ; __t = 1 - __shift_zero
    add __t, 1
    mul __shift_r, __t
    mul c3, __shift_r, __shift_sign         ; put the sign back

; Returns `c1` shifted right by `c2` bits: floor(|`c1`| / 2^`c2`) with the sign of `c1`, so -5 >> 1 is -2.
; Branchless version of `slow_shift_right`.
; Only the 31 bits below the sign bit are shifted: the shift works on |`c1`| and the result gets the sign of `c1`. GD's arithmetic is only exact up to 16,777,216, so larger values may lose their lowest bits.
; @param c1 the integer
; @param c2 the number of bits (negative counts as 0; 31 or more gives 0)
; @returns c3 c1 >> c2
; @0tick
fast_shift_right:
    mov __shift_a, c1           | resmode:+
    div __shift_sign, c1, __shift_a         ; sign of c1 (0 for 0)
    mov __cs1, c2               | resmode:+                 ; c2 > 0
    add __cs2, c2, __cs1        | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __shift_n, __cs2, __cs3 | resmode:ceil
    mul __shift_n, c2                       ; n = max(c2, 0)
    mov __t, __shift_n
    sub __t, 30
    mov __cs1, __t              | resmode:+                 ; n > 30: every bit is shifted out
    add __cs2, __t, __cs1       | itemmod:2 divmod:true     ; max(d, 0)
    mov __cs3, __cs2
    add __cs3, 1
    div __shift_zero, __cs2, __cs3 | resmode:ceil
    mul __t, __shift_zero
    sub __shift_n, __t                      ; n = min(n, 30)
    mov __shift_m, __shift_n
    mov __shift_p, 1
    mov __shift_bit, __shift_m              ; bit 16 of the exponent
    fldiv __shift_bit, 16
    sub __shift_m, __shift_bit  | itemmod:16
    mov __shift_fac, __shift_bit | itemmod:65535
    add __shift_fac, 1                      ; 2^16 if the bit is set, else 1
    mul __shift_p, __shift_fac
    mov __shift_bit, __shift_m              ; bit 8 of the exponent
    fldiv __shift_bit, 8
    sub __shift_m, __shift_bit  | itemmod:8
    mov __shift_fac, __shift_bit | itemmod:255
    add __shift_fac, 1                      ; 2^8 if the bit is set, else 1
    mul __shift_p, __shift_fac
    mov __shift_bit, __shift_m              ; bit 4 of the exponent
    fldiv __shift_bit, 4
    sub __shift_m, __shift_bit  | itemmod:4
    mov __shift_fac, __shift_bit | itemmod:15
    add __shift_fac, 1                      ; 2^4 if the bit is set, else 1
    mul __shift_p, __shift_fac
    mov __shift_bit, __shift_m              ; bit 2 of the exponent
    fldiv __shift_bit, 2
    sub __shift_m, __shift_bit  | itemmod:2
    mov __shift_fac, __shift_bit | itemmod:3
    add __shift_fac, 1                      ; 2^2 if the bit is set, else 1
    mul __shift_p, __shift_fac
    mov __shift_bit, __shift_m              ; bit 1 of the exponent
    fldiv __shift_bit, 1
    sub __shift_m, __shift_bit  | itemmod:1
    mov __shift_fac, __shift_bit | itemmod:1
    add __shift_fac, 1                      ; 2^1 if the bit is set, else 1
    mul __shift_p, __shift_fac
    fldiv __shift_r, __shift_a, __shift_p
    mov __t, __shift_zero       | itemmod:-1                ; __t = 1 - __shift_zero
    add __t, 1
    mul __shift_r, __t
    mul c3, __shift_r, __shift_sign         ; put the sign back

; Returns ~`c1` over the 31 bits below the sign bit: 2147483647 - |`c1`|.
; The result is above 16,777,216 for small inputs, where GD's arithmetic may round its lowest bits.
; @param c1 the integer
; @returns c3 ~c1
; @0tick
bitwise_not:
    mov c3, c1                  | resmode:+
    mul c3, -1
    sub c3, 1
    add c3, 1073741824                      ; + 2^30 twice, so that no step leaves the counter range
    add c3, 1073741824

; ---- internal routines; don't spawn these directly ----

; __and_y = |__and_a| AND |__and_b|, bit by bit over the 31 bits below the sign bit.
; Takes the bits from the highest down: bit = floor(x / 2^i), then x -= bit * 2^i.
; @param __and_a
; @param __and_b
; @returns __and_y
; @0tick
__and:
    mov __a, __and_a            | resmode:+
    mov __b, __and_b            | resmode:+
    mov __and_y, 0
    mov __bit_a, __a                        ; bit 30
    fldiv __bit_a, 1073741824
    sub __a, __bit_a            | itemmod:1073741824
    mov __bit_b, __b
    fldiv __bit_b, 1073741824
    sub __b, __bit_b            | itemmod:1073741824
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:1073741824
    mov __bit_a, __a                        ; bit 29
    fldiv __bit_a, 536870912
    sub __a, __bit_a            | itemmod:536870912
    mov __bit_b, __b
    fldiv __bit_b, 536870912
    sub __b, __bit_b            | itemmod:536870912
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:536870912
    mov __bit_a, __a                        ; bit 28
    fldiv __bit_a, 268435456
    sub __a, __bit_a            | itemmod:268435456
    mov __bit_b, __b
    fldiv __bit_b, 268435456
    sub __b, __bit_b            | itemmod:268435456
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:268435456
    mov __bit_a, __a                        ; bit 27
    fldiv __bit_a, 134217728
    sub __a, __bit_a            | itemmod:134217728
    mov __bit_b, __b
    fldiv __bit_b, 134217728
    sub __b, __bit_b            | itemmod:134217728
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:134217728
    mov __bit_a, __a                        ; bit 26
    fldiv __bit_a, 67108864
    sub __a, __bit_a            | itemmod:67108864
    mov __bit_b, __b
    fldiv __bit_b, 67108864
    sub __b, __bit_b            | itemmod:67108864
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:67108864
    mov __bit_a, __a                        ; bit 25
    fldiv __bit_a, 33554432
    sub __a, __bit_a            | itemmod:33554432
    mov __bit_b, __b
    fldiv __bit_b, 33554432
    sub __b, __bit_b            | itemmod:33554432
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:33554432
    mov __bit_a, __a                        ; bit 24
    fldiv __bit_a, 16777216
    sub __a, __bit_a            | itemmod:16777216
    mov __bit_b, __b
    fldiv __bit_b, 16777216
    sub __b, __bit_b            | itemmod:16777216
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:16777216
    mov __bit_a, __a                        ; bit 23
    fldiv __bit_a, 8388608
    sub __a, __bit_a            | itemmod:8388608
    mov __bit_b, __b
    fldiv __bit_b, 8388608
    sub __b, __bit_b            | itemmod:8388608
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:8388608
    mov __bit_a, __a                        ; bit 22
    fldiv __bit_a, 4194304
    sub __a, __bit_a            | itemmod:4194304
    mov __bit_b, __b
    fldiv __bit_b, 4194304
    sub __b, __bit_b            | itemmod:4194304
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:4194304
    mov __bit_a, __a                        ; bit 21
    fldiv __bit_a, 2097152
    sub __a, __bit_a            | itemmod:2097152
    mov __bit_b, __b
    fldiv __bit_b, 2097152
    sub __b, __bit_b            | itemmod:2097152
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:2097152
    mov __bit_a, __a                        ; bit 20
    fldiv __bit_a, 1048576
    sub __a, __bit_a            | itemmod:1048576
    mov __bit_b, __b
    fldiv __bit_b, 1048576
    sub __b, __bit_b            | itemmod:1048576
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:1048576
    mov __bit_a, __a                        ; bit 19
    fldiv __bit_a, 524288
    sub __a, __bit_a            | itemmod:524288
    mov __bit_b, __b
    fldiv __bit_b, 524288
    sub __b, __bit_b            | itemmod:524288
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:524288
    mov __bit_a, __a                        ; bit 18
    fldiv __bit_a, 262144
    sub __a, __bit_a            | itemmod:262144
    mov __bit_b, __b
    fldiv __bit_b, 262144
    sub __b, __bit_b            | itemmod:262144
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:262144
    mov __bit_a, __a                        ; bit 17
    fldiv __bit_a, 131072
    sub __a, __bit_a            | itemmod:131072
    mov __bit_b, __b
    fldiv __bit_b, 131072
    sub __b, __bit_b            | itemmod:131072
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:131072
    mov __bit_a, __a                        ; bit 16
    fldiv __bit_a, 65536
    sub __a, __bit_a            | itemmod:65536
    mov __bit_b, __b
    fldiv __bit_b, 65536
    sub __b, __bit_b            | itemmod:65536
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:65536
    mov __bit_a, __a                        ; bit 15
    fldiv __bit_a, 32768
    sub __a, __bit_a            | itemmod:32768
    mov __bit_b, __b
    fldiv __bit_b, 32768
    sub __b, __bit_b            | itemmod:32768
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:32768
    mov __bit_a, __a                        ; bit 14
    fldiv __bit_a, 16384
    sub __a, __bit_a            | itemmod:16384
    mov __bit_b, __b
    fldiv __bit_b, 16384
    sub __b, __bit_b            | itemmod:16384
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:16384
    mov __bit_a, __a                        ; bit 13
    fldiv __bit_a, 8192
    sub __a, __bit_a            | itemmod:8192
    mov __bit_b, __b
    fldiv __bit_b, 8192
    sub __b, __bit_b            | itemmod:8192
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:8192
    mov __bit_a, __a                        ; bit 12
    fldiv __bit_a, 4096
    sub __a, __bit_a            | itemmod:4096
    mov __bit_b, __b
    fldiv __bit_b, 4096
    sub __b, __bit_b            | itemmod:4096
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:4096
    mov __bit_a, __a                        ; bit 11
    fldiv __bit_a, 2048
    sub __a, __bit_a            | itemmod:2048
    mov __bit_b, __b
    fldiv __bit_b, 2048
    sub __b, __bit_b            | itemmod:2048
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:2048
    mov __bit_a, __a                        ; bit 10
    fldiv __bit_a, 1024
    sub __a, __bit_a            | itemmod:1024
    mov __bit_b, __b
    fldiv __bit_b, 1024
    sub __b, __bit_b            | itemmod:1024
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:1024
    mov __bit_a, __a                        ; bit 9
    fldiv __bit_a, 512
    sub __a, __bit_a            | itemmod:512
    mov __bit_b, __b
    fldiv __bit_b, 512
    sub __b, __bit_b            | itemmod:512
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:512
    mov __bit_a, __a                        ; bit 8
    fldiv __bit_a, 256
    sub __a, __bit_a            | itemmod:256
    mov __bit_b, __b
    fldiv __bit_b, 256
    sub __b, __bit_b            | itemmod:256
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:256
    mov __bit_a, __a                        ; bit 7
    fldiv __bit_a, 128
    sub __a, __bit_a            | itemmod:128
    mov __bit_b, __b
    fldiv __bit_b, 128
    sub __b, __bit_b            | itemmod:128
    mul __p, __bit_a, __bit_b
    add __and_y, __p            | itemmod:128
    mov __bit_a, __a                        ; bit 6
