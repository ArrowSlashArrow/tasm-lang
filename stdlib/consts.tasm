; useful numbers
;
; The aliases below are for use as modifiers, e.g. `mul t2, consts::PI`. GD keeps only 3 decimals of
; a modifier (and changes some large ones, see docs section 3.1.2.1.1), so `consts::PI` acts as 3.141
; there. For the precise value, spawn the matching load_const_* routine (0-tickable), which writes the
; constant into t1 as precisely as a timer can hold it.

_init:
    ; tasm-specific numbers
    alias MAX_GROUP,        g9999
    alias MAX_SAFE_INT,     134217          ; every integer up to this survives as a modifier (docs section 3.1.2.1.1)
    alias MIN_SAFE_INT,     -134217         ; every integer down to this survives as a modifier
    alias INT_LIMIT,        2147483647      ; largest counter value. Too long for a modifier (GD saves it as 2147480064)
    alias NEG_INT_LIMIT,    -2147483648     ; smallest counter value. Too long for a modifier (GD saves it as -2147480064)
    alias MAX_TIMER_VALUE,  9999999.0       ; largest value a timer will accept from an item edit trigger. Too long for a
                                            ; modifier: GD saves it as 10000000

    ; math numbers. source: https://doc.rust-lang.org/src/core/num/f32.rs.html
    ; see docs section 3.1.2.1.1 about loading constants, and the load_const_* routines below
    alias PI,               3.14159265358979323846264338327950288
    alias TAU,              6.28318530717958647692528676655900577
    alias E,                2.71828182845904523536028747135266250
    alias GOLDEN_RATIO,     1.618033988749894848204586834365638118
    alias EULER_GAMMA,      0.577215664901532860606512090082402431      ; The Euler-Mascheroni constant (γ)
    alias HALF_PI,          1.57079632679489661923132169163975144
    alias FRAC_PI_3,        1.04719755119659774615421446109316763       ; pi/3
    alias FRAC_PI_4,        0.785398163397448309615660845819875721      ; pi/4
    alias FRAC_PI_6,        0.52359877559829887307710723054658381       ; pi/6
    alias FRAC_PI_8,        0.39269908169872415480783042290993786       ; pi/8
    alias FRAC_1_PI,        0.318309886183790671537767526745028724      ; 1/pi
    alias SQRT_2,           1.41421356237309504880168872420969808
    alias FRAC_1_SQRT_2,    0.707106781186547524400844362104849039      ; 1 / sqrt2
    alias LOG2_E,           1.44269504088896340735992468100189214
    alias LOG2_10,          3.32192809488736234787031942948939018
    alias LOG10_E,          0.434294481903251827651128918916605082
    alias LOG10_2,          0.301029995663981195213738894724493027
    alias LN_2,             0.693147180559945309417232121458176568
    alias LN_10,            2.30258509299404568401799145468436421

; Loads `PI` into t1: the closest value a timer can hold to 3.141592653589793238...
; It's built as (((9036 / 2^17 - 62650) / 2^17 - 38263) / 2^17 + 102944) / 2^15: every number in the
; routine is an integer of at most 2^17, which GD stores exactly (see docs section 3.1.2.1.1).
; @param t1 Where the constant will be written
; @0tick
load_const_PI:
    mov t1, 9036
    div t1, 131072
    add t1, -62650
    div t1, 131072
    add t1, -38263
    div t1, 131072
    add t1, 102944
    div t1, 32768

; Loads `TAU` into t1: the closest value a timer can hold to 6.283185307179586476...
; It's built as (((9036 / 2^17 - 62650) / 2^17 - 38263) / 2^17 + 102944) / 2^14: every number in the
; routine is an integer of at most 2^17, which GD stores exactly (see docs section 3.1.2.1.1).
; @param t1 Where the constant will be written
; @0tick
load_const_TAU:
    mov t1, 9036
    div t1, 131072
    add t1, -62650
    div t1, 131072
    add t1, -38263
    div t1, 131072
    add t1, 102944
    div t1, 16384

