; useful numbers
;
; The aliases below are for use as modifiers, e.g. `mul t2, consts::PI`. GD keeps only 3 decimals of
; a modifier, so `consts::PI` acts as 3.141 there. For the precise value, spawn the matching
; load_const_* routine (0-tickable), which writes the constant into t1 as precisely as a timer can
; hold it. These routines use t9950 internally.

_init:
    ; tasm-specific numbers
    alias MAX_GROUP,        g9999
    alias MAX_SAFE_INT,     16777216        ; maximum integer that can be a modifier at full precision
    alias MIN_SAFE_INT,     -16777216       ; minumum integer that can be a modifier at full precision
    alias INT_LIMIT,        2147483647
    alias NEG_INT_LIMIT,    -2147483648
    alias MAX_TIMER_VALUE,  9999999.0    ; maximum value a timer will accept from an item edit trigger

    ; math numbers. source: https://doc.rust-lang.org/src/core/num/f32.rs.html
    ; see docs section 3.1.2.1.1 about loading constants, and the load_const_* routines below
    alias PI,               3.14159265358979323846264338327950288
    alias TAU,              6.28318530717958647692528676655900577
    alias E,                2.71828182845904523536028747135266250
    alias GOLDEN_RATIO,     1.618033988749894848204586834365638118
    alias EULER_GAMMA,      0.577215664901532860606512090082402431      ; The Euler-Mascheroni constant (γ)
    alias HALF_PI,          1.57079632679489661923132169163975144
    alias FRAC_PI_3,        1.04719755119659774615421446109316763       ; pi/3
    alias FRAC_PI_4,        0.785398163397448309615660845819875721      ; pi/4
    alias FRAC_PI_6,        0.52359877559829887307710723054658381       ; pi/6
    alias FRAC_PI_8,        0.39269908169872415480783042290993786       ; pi/8
    alias FRAC_1_PI,        0.318309886183790671537767526745028724      ; 1/pi
    alias SQRT_2,           1.41421356237309504880168872420969808
    alias FRAC_1_SQRT_2,    0.707106781186547524400844362104849039      ; 1 / sqrt2
    alias LOG2_E,           1.44269504088896340735992468100189214
    alias LOG2_10,          3.32192809488736234787031942948939018
    alias LOG10_E,          0.434294481903251827651128918916605082
    alias LOG10_2,          0.301029995663981195213738894724493027
    alias LN_2,             0.693147180559945309417232121458176568
    alias LN_10,            2.30258509299404568401799145468436421

    ; internal alias
    alias __consts_k,       t9950         ; scratch: the part being added

; Loads `PI` into t1, to the full precision of a timer: the closest value
; a timer can hold to 3.141592653589793238...
; The constant is built from three integers below 2^23, each divided by a power of two:
; 6588397 / 2^21 + 2656346 / 2^44 + 1590937 / 2^67.
; @param t1 Where the constant will be written
; @0tick
load_const_PI:
    mov t1, 6588397
    div t1, 2097152                   ; t1 = 6588397 / 2^21
    mov __consts_k, 2656346
    add t1, __consts_k          | itemmod:17592186044416 divmod:true
    mov __consts_k, 1590937
    add t1, __consts_k          | itemmod:147573952589676412928 divmod:true

; Loads `TAU` into t1, to the full precision of a timer: the closest value
; a timer can hold to 6.283185307179586476...
; The constant is built from three integers below 2^23, each divided by a power of two:
; 6588397 / 2^20 + 2656346 / 2^43 + 1590937 / 2^66.
; @param t1 Where the constant will be written
; @0tick
load_const_TAU:
    mov t1, 6588397
    div t1, 1048576                   ; t1 = 6588397 / 2^20
    mov __consts_k, 2656346
    add t1, __consts_k          | itemmod:8796093022208 divmod:true
    mov __consts_k, 1590937
    add t1, __consts_k          | itemmod:73786976294838206464 divmod:true

; Loads `E` into t1, to the full precision of a timer: the closest value
; a timer can hold to 2.718281828459045235...
; The constant is built from three integers below 2^23, each divided by a power of two:
; 5700650 / 2^21 + 1452207 / 2^44 + -1485994 / 2^67.
; @param t1 Where the constant will be written
; @0tick
load_const_E:
    mov t1, 5700650
    div t1, 2097152                   ; t1 = 5700650 / 2^21
    mov __consts_k, 1452207
    add t1, __consts_k          | itemmod:17592186044416 divmod:true
    mov __consts_k, -1485994
    add t1, __consts_k          | itemmod:147573952589676412928 divmod:true

; Loads `GOLDEN_RATIO` into t1, to the full precision of a timer: the closest value
; a timer can hold to 1.618033988749894848...
; The constant is built from three integers below 2^23, each divided by a power of two:
; 6786526 / 2^22 + 3616745 / 2^45 + 2605407 / 2^68.
; @param t1 Where the constant will be written
; @0tick
load_const_GOLDEN_RATIO:
    mov t1, 6786526
    div t1, 4194304                   ; t1 = 6786526 / 2^22
    mov __consts_k, 3616745
    add t1, __consts_k          | itemmod:35184372088832 divmod:true
    mov __consts_k, 2605407
    add t1, __consts_k          | itemmod:295147905179352825856 divmod:true

; Loads `EULER_GAMMA` (The Euler-Mascheroni constant (γ)) into t1, to the full precision of a timer: the closest value
; a timer can hold to 0.577215664901532860...
; The constant is built from three integers below 2^23, each divided by a power of two:
; 4842036 / 2^23 + -467092 / 2^46 + 1635482 / 2^69.
; @param t1 Where the constant will be written
; @0tick
load_const_EULER_GAMMA:
    mov t1, 4842036
    div t1, 8388608                   ; t1 = 4842036 / 2^23
    mov __consts_k, -467092
    add t1, __consts_k          | itemmod:70368744177664 divmod:true
    mov __consts_k, 1635482
    add t1, __consts_k          | itemmod:590295810358705651712 divmod:true

