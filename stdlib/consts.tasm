; useful numbers

_init:
    ; tasm-specific numbers
    alias MAX_GROUP,    g9999
    alias MAX_SAFE_INT, 16777216
    alias MIN_SAFE_INT, -16777216
    alias INT_LIMIT,    2147483647
    alias NEG_INT_LIMIT,-21247483648

    ; math numbers. source: https://doc.rust-lang.org/src/core/num/f32.rs.html
    alias PI,           3.14159265358979323846264338327950288
    alias TAU,          6.28318530717958647692528676655900577
    alias E,            2.71828182845904523536028747135266250
    alias GOLDEN_RATIO, 1.618033988749894848204586834365638118
    ; The Euler-Mascheroni constant (γ)
    alias EULER_GAMMA,  0.577215664901532860606512090082402431
    alias HALF_PI,      1.57079632679489661923132169163975144
    ; pi/3
    alias FRAC_PI_3,    1.04719755119659774615421446109316763
    ; pi/4
    alias FRAC_PI_4,    0.785398163397448309615660845819875721
    ; pi/6
    alias FRAC_PI_6,    0.52359877559829887307710723054658381
    ; pi/8
    alias FRAC_PI_8,    0.39269908169872415480783042290993786
    ; 1/pi
    alias FRAC_1_PI,    0.318309886183790671537767526745028724
    alias SQRT_2,       1.41421356237309504880168872420969808
    ; 1 / sqrt2
    alias FRAC_1_SQRT_2,0.707106781186547524400844362104849039
    alias LOG2_E,       1.44269504088896340735992468100189214
    alias LOG2_10,      3.32192809488736234787031942948939018
    alias LOG10_E,      0.434294481903251827651128918916605082
    alias LOG10_2,      0.301029995663981195213738894724493027
    alias LN_2,         0.693147180559945309417232121458176568
    alias LN_10,        2.30258509299404568401799145468436421