; Sample implementation of a random number generator.
_init:
    display t1
    display t2
    display t3

set1:
    mov t2, 1
set0:
    mov t2, 0

rand_iter:
    ifrand set0, set1, 50
    
    mul T2, T3
    add T1, T2

    div T3, 2
    sg rand_iter, T3, 0.1   | ordered:false

_start:
    mov T3, 8388608 ; factor
    mul T1, T3, -1  ; result
    spawn rand_iter         | ordered:false delay:0