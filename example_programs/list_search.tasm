_init:
    import ../stdlib/mem_8bit
    ; load list
    mov C30, 1
    mov C31, 2
    mov C32, 3
    mov C33, 5
    mov C34, 9
    mov C35, 2
    mov C36, 5
    mov C37, 1
    mov C38, 56
    mov C39, 2
    mov C40, 6
    mov C41, 3
    mov C42, 4
    mov C43, 16
    mov C44, 23
    mov C45, 59
    mov C46, 20
    mov C47, 10
    display C4
    display mem_8bit::_std_mem_ptrpos
    display mem_8bit::_std_mem_cmemreg

_start:
    ; setup params
    mov C1, 20  ; list start
    mov C2, 18  ; list length
    mov C3, 5   ; target number
    mov C4, -1  ; return variable

    ; setup temp vars
    add C5, C1, C2  ; end addr of list
    mov C5, 50
    mov mem_8bit::_std_mem_ptrpos, C1
    spawn search_iter

search_iter:
    ; mget
    SPAWN mem_8bit::mem   | ordered:false remap: {mem_8bit::_std_mem_end = mem_8bit::_std_mem_cread}
    ise found, mem_8bit::_std_mem_cmemreg, C3    ; end if number is found
    add mem_8bit::_std_mem_ptrpos, 1

    ; goto not_found if ptrpos > end list addr
    fle search_iter, not_found, mem_8bit::_std_mem_ptrpos, C5

found:
    ; due to the timing caused by iterating over this group with the last instruction of search_iter,
    ; the first kill instruction does not work. the second actually terminates that process.
    kill search_iter
    kill search_iter
    mov C4, 1

not_found:
    mov C4, 0